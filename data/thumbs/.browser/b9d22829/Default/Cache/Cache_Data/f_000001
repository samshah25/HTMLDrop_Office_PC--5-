      +`<span class="ql ql-t"><b>${M.length.toLocaleString('en-IN')}</b>${S.active?'active '+RL+'s shown':RL+'s shown (incl. left)'}</span><span class="ql-h">Dot size = ₹ lost (or extra ₹ collected) compared with the same team</span>`; }
