  background-image:radial-gradient(rgba(255,255,255,.10) 1px,transparent 1.2px);background-size:14px 14px;
  -webkit-mask-image:linear-gradient(90deg,transparent 35%,#000);mask-image:linear-gradient(90deg,transparent 35%,#000)}
.brand{display:flex;align-items:center;gap:14px;position:relative;z-index:1;min-width:0}
.logo{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;flex:none;
  background:linear-gradient(135deg,#5b6cff,#22b38a);box-shadow:0 6px 18px -6px rgba(91,108,255,.8),inset 0 1px 0 rgba(255,255,255,.25)}
