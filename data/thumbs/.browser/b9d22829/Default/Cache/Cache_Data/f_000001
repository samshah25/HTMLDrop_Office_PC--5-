    let h=row('mt-all','all','All teams',(D.head&&D.branches.length===1?ex(D.head)+' · ':'')+pl(total),isAll);
    for(const g of groups){ h+=row('mt-m2','g'+g.j,g.n,'manager · '+pl(g.cnt),gSel===g);
      if(g.tl.length===1&&D.managers[g.tl[0]]===g.n) continue;   // manager with only direct reports: no child row
      for(const i of g.tl.sort((a,b)=>(D.managers[b]===g.n)-(D.managers[a]===g.n)||c[b]-c[a])) h+=row('mt-tl','t'+i+' g'+g.j,D.managers[i],(D.managers[i]===g.n?'direct reports · ':'team leader · ')+pl(c[i]),!isAll&&!gSel&&cur.size===1&&cur.has(i)); }
