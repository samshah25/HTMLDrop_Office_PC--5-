.tiles{gap:14px!important;background:none!important;border:0!important;box-shadow:none!important;overflow:visible!important;padding:2px 0 8px}
.tile,.tile+.tile{border:1px solid color-mix(in srgb,var(--c,#8b93b8) 16%,var(--line))!important;border-radius:18px!important;
  background:linear-gradient(165deg,var(--surface) 0%,color-mix(in srgb,var(--surface) 93%,#c9cde0) 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -2px 0 rgba(20,22,27,.04),
    0 6px 0 -1px color-mix(in srgb,var(--c,#8b93b8) 30%,#dfe1ea),0 20px 30px -16px rgba(20,22,27,.32)!important;
  transform:translateY(-3px)}
