  --shadow:0 1px 0 rgba(20,22,27,.03),0 10px 30px -18px rgba(20,22,27,.22);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0c0e13; --surface:#14171f; --line:#262a35; --grid:#1c2029; --chip:#1a1e28;
    --ink:#eef0f5; --ink2:#b5bac6; --ink3:#7d8392;
    --s1:#7586ff; --s1-soft:#262e66; --pos:#7586ff; --pos2:#3a4699;
    --crit:#ef6b60; --warnc:#f2b33d; --good:#35c08a;
    --out1:#ef6b60; --out2:#eea867; --out3:#3a4356;
    --k-blue:#7586ff; --k-red:#ef6b60; --k-orange:#f09a5a; --k-violet:#a28bff; --hero3:#7586ff;
    --bar1:#121628; --bar2:#1d2547; --money1:#1d2547; --money2:#2a3466;
    --shadow:0 1px 0 rgba(0,0,0,.4),0 10px 30px -18px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0c0e13; --surface:#14171f; --line:#262a35; --grid:#1c2029; --chip:#1a1e28;
  --ink:#eef0f5; --ink2:#b5bac6; --ink3:#7d8392;
  --s1:#7586ff; --s1-soft:#262e66; --pos:#7586ff; --pos2:#3a4699;
  --crit:#ef6b60; --warnc:#f2b33d; --good:#35c08a;
  --out1:#ef6b60; --out2:#eea867; --out3:#3a4356;
  --k-blue:#7586ff; --k-red:#ef6b60; --k-orange:#f09a5a; --k-violet:#a28bff; --hero3:#7586ff;
  --bar1:#121628; --bar2:#1d2547; --money1:#1d2547; --money2:#2a3466;
  --shadow:0 1px 0 rgba(0,0,0,.4),0 10px 30px -18px rgba(0,0,0,.7);
}
html{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{background-color:var(--bg);background-image:radial-gradient(900px 420px at 50% -260px,color-mix(in srgb,var(--s1) 12%,transparent),transparent);background-repeat:no-repeat;
  color:var(--ink);font:14px/1.5 var(--sans);font-feature-settings:"cv11","ss01"}
.wrap{max-width:1280px;padding-inline:16px;padding-block:18px 64px;gap:16px}
