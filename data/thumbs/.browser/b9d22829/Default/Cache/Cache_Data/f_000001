  const W=1180,H=500,L=58,R=12,T=8,B=40,GX=0,GY=0; const s=svg($('#cQ'),W,H); if(!M.length) return;
  const NICE=[20,30,50,75,100,150,200,300,500,750,1000]; const nmax=Math.max(...M.map(m=>m.n)); const xmax=NICE.find(v=>v>=nmax)||nmax;
