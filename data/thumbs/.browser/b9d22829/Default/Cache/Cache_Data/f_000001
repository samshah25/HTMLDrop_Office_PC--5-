.appbar h1{color:#fff;font-size:26px;font-weight:800;margin:3px 0 0;display:flex;align-items:center;gap:10px}
.appbar .info{color:rgba(255,255,255,.75);background:rgba(255,255,255,.10);border-color:transparent}
