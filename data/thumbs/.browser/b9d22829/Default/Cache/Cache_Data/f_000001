  const allSet=()=>new Set(D.managers.map((_,i)=>i));
  const same=(a,b)=>{ if(a.size!==b.size) return false; for(const x of a) if(!b.has(x)) return false; return true; };
  const counts=()=>{ const c=new Array(D.managers.length).fill(0), seen=new Set();
    for(const d of D.deals){ if(!passOther(d,'mgrs')) continue; const e=d[F.me]; if(seen.has(e)) continue; seen.add(e); c[D.people[e][3]]++; } return c; };
  const draw=()=>{
    const c=counts(), RL=D.roles?D.roles[S.role]:'ME', up=D.mgrUp||D.managers.map(()=>0), m2=D.managers2||['All'];
    const pl=n=>`${n.toLocaleString('en-IN')} ${RL}${n===1?'':'s'}`;
    const groups=m2.map((n,j)=>({n,j,tl:D.managers.map((_,i)=>i).filter(i=>up[i]===j&&c[i]>0)})).filter(g=>g.tl.length)
      .map(g=>({...g,cnt:g.tl.reduce((s,i)=>s+c[i],0)})).sort((a,b)=>b.cnt-a.cnt);
    const total=c.reduce((s,v)=>s+v,0), cur=S.mgrs, isAll=same(cur,allSet());
    const gSel=isAll?null:groups.find(g=>same(cur,new Set(g.tl)));
