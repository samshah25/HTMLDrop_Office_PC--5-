        else r.style.display=(r.dataset.n.includes(q)||gm[k[1]])?'':'none'; }); };
    qi.value=det._q||''; qi.oninput=ap; qi.onkeydown=e=>{ if(e.key==='Enter'){ e.preventDefault(); const f=[...det.querySelectorAll('.mt-row')].find(r=>r.style.display!=='none'); if(f) f.click(); } }; ap();
