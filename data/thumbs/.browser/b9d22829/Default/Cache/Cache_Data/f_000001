  background:radial-gradient(400px 160px at 100% 0%,rgba(224,79,120,.35),transparent 70%),linear-gradient(160deg,#1d2133,#11131c)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 6px 0 -1px #0a0c14,0 22px 32px -16px rgba(10,12,20,.55)!important}
.tile::before{box-shadow:inset 0 2px 6px rgba(20,22,27,.08)}
.tile::after{animation:kfloat 3.4s ease-in-out infinite}
.tile:nth-child(2)::after{animation-delay:-.7s} .tile:nth-child(3)::after{animation-delay:-1.4s} .tile:nth-child(4)::after{animation-delay:-2.1s} .tile:nth-child(5)::after{animation-delay:-2.8s}
@keyframes kfloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
