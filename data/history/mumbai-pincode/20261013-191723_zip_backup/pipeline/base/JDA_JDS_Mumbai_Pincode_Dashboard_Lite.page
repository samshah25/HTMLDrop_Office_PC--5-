function fmtDateNice(iso) {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function periodLabel() {
  if (periodFromDate === DAILY.window_start && periodToDate === DAILY.window_end) return `Full window (${fmtDateNice(DAILY.window_start)}–${fmtDateNice(DAILY.window_end)})`;
  if (periodFromDate === periodToDate) return fmtDateNice(periodFromDate) + ' only';
  return `${fmtDateNice(periodFromDate)}–${fmtDateNice(periodToDate)}`;
}

const MAIN_DISTRICTS_TEXT = 'Hooghly | Howrah | Kolkata | North 24 Parganas | South 24 Parganas';
let currentBaseRows = [];   // rows passing every filter except the category cards (for card counts)
let filterChips = [];
function setScenarioUI(scn) {
  document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === scn));
  applyScenario(scn);
}
function setCityScopeUI(cs) {
  const sel = document.getElementById('cityScopeSelect'); if (sel) sel.value = cs;
  applyCityScope(cs);
}
function columnFilterChipLabel(field, f) {
  const name = COLUMN_LABELS[field] || field;
  if (f.type === 'numeric') return `${name} ${f.op} ${f.value}`;
  const vals = Array.from(f.values);
  return vals.length <= 3 ? `${name}: ${vals.join(', ')}` : `${name}: ${vals.length} of ${getDistinctValues(field).length} selected`;
}
function buildFilterChips() {
  const chips = [];
  if (currentScenario !== 'all') chips.push({ label: currentScenario === 'fresh' ? 'Fresh only' : 'Renewal only', clear: () => setScenarioUI('all') });
  if (currentCityScope === 'main') chips.push({ label: `Main only: ${MAIN_DISTRICTS_TEXT}`, clear: () => setCityScopeUI('both') });
  if (currentCityScope === 'remote') chips.push({ label: 'Remote only: outside the 5 main districts', clear: () => setCityScopeUI('both') });
  if (!(periodFromDate === DAILY.window_start && periodToDate === DAILY.window_end))
    chips.push({ label: `Period: ${periodLabel()}`, clear: () => setPeriod(DAILY.window_start, DAILY.window_end) });
  Object.keys(columnFilters).forEach(field => {
    if (!isColumnFilterActive(field)) return;
    const fromManager = field === 'pincode' && savedLayerVisibleBeforeMgrFilter;
    chips.push({ label: fromManager ? `Pincodes of one manager's team (${columnFilters[field].values.size})` : columnFilterChipLabel(field, columnFilters[field]),
      clear: fromManager ? () => clearManagerFilter() : () => { delete columnFilters[field]; renderTableHead(); refreshAll(); } });
  });
  const q = document.getElementById('searchBox').value.trim();
  if (q) chips.push({ label: `Table search: “${q}”`, clear: () => { document.getElementById('searchBox').value = ''; renderTable(currentRows); renderFilterBar(); writeUrlState(); } });
  return chips;
}
function filterSummaryText() {
  const scn = currentScenario === 'all' ? 'Fresh + Renewal' : currentScenario === 'fresh' ? 'Fresh only' : 'Renewal only';
  const city = currentCityScope === 'both' ? 'All branch pincodes' : currentCityScope === 'main' ? `Main only (${MAIN_DISTRICTS_TEXT})` : 'Remote only';
  const extra = buildFilterChips().map(c => c.label).filter(l => !l.startsWith('Period:') && !l.startsWith('Main only') && !l.startsWith('Remote only') && l !== scn);
  const hidden = renderedLayerKeys().filter(k => !layerVisible[k]).map(cardShortLabel);
  return [scn, city, periodLabel()].concat(extra).concat(hidden.length ? [`Hidden: ${hidden.join(', ')}`] : []).join(' | ');
}
function renderFilterBar() {
  filterChips = buildFilterChips();
  const esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  document.getElementById('scenarioNote').innerHTML = `<div class="filter-bar">${
    filterChips.length
      ? `<span class="fb-label">Filters:</span>${filterChips.map((c, i) => `<span class="chip">${esc(c.label)}<button data-chip="${i}" aria-label="Remove filter: ${esc(c.label)}" title="Remove this filter">×</button></span>`).join('')}<button class="fb-link" id="clearAllFiltersBtn">Clear all</button>`
      : `<span class="fb-label">Showing Fresh + Renewal, ${esc(periodLabel())}.</span>`
  }<button class="fb-link" id="copyViewLinkBtn" title="Copy a link that opens the dashboard with these filters">Copy link to this view</button></div>`;
}
function clearAllFilters() {
  columnFilters = {};
  if (savedLayerVisibleBeforeMgrFilter) { savedLayerVisibleBeforeMgrFilter = null; document.getElementById('mgrFilterBadge').style.display = 'none'; }
  document.getElementById('searchBox').value = '';
  currentScenario = 'all';
  document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === 'all'));
  currentCityScope = 'both';
