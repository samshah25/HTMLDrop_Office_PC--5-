// ---------------- Export: Excel (CSV) and PDF (browser print) ----------------
// Reads straight from the live #dataTable DOM, so exports always exactly match
// whatever is currently filtered/sorted/visible on screen (search box, layer
// toggles, column filters, period, Fresh/Renewal, and the advanced-metrics
// column toggle are all reflected automatically).
function getVisibleExportColumns() {
  return Array.from(document.querySelectorAll('#dataTable thead th'))
    .map((th, i) => ({ idx: i, label: th.textContent.replace(/[↓↑]\d*/g, '').replace(/▾/g, '').trim(), visible: getComputedStyle(th).display !== 'none' }))
    .filter(c => c.visible);
}
function getExportRows() {
  const cols = getVisibleExportColumns();
  const trs = Array.from(document.querySelectorAll('#dataTable tbody tr')).filter(tr => !tr.classList.contains('expand-row'));
  const rows = trs.map(tr => cols.map(c => (tr.children[c.idx] ? tr.children[c.idx].textContent.replace(/^[▸▾]\s*/, '').trim() : '')));
  return { headers: cols.map(c => c.label), rows };
}
function csvEscape(v) {
  const s = String(v == null ? '' : v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}
function timestamp() {
  const d = new Date();
  const p = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}_${p(d.getHours())}${p(d.getMinutes())}`;
}
function exportExcel() {
  const { headers, rows } = getExportRows();
  if (!rows.length) { alert('No pincodes match the current filters — nothing to export.'); return; }
  const lines = [headers.map(csvEscape).join(',')].concat(rows.map(r => r.map(csvEscape).join(',')));
  const csv = '﻿' + lines.join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `kolkata_jda_jds_export_${timestamp()}.csv`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function exportPdf() {
  const { headers, rows } = getExportRows();
  if (!rows.length) { alert('No pincodes match the current filters — nothing to export.'); return; }
  const summary = filterSummaryText();
  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const headHtml = headers.map(h => `<th>${esc(h)}</th>`).join('');
  const rowsHtml = rows.map(r => '<tr>' + r.map(v => `<td>${esc(v)}</td>`).join('') + '</tr>').join('');
  const area = document.getElementById('printExportArea');
  area.innerHTML = `
    <h1><img class="jd-logo" src="data:image/png;base64," alt="Justdial" style="height:1.1em; width:auto; vertical-align:-0.16em; margin-right:12px;">JDA vs JDS pincode coverage, Mumbai branch</h1>
    <p class="pe-meta">${esc(summary)} &nbsp;|&nbsp; Generated ${esc(new Date().toLocaleString())}</p>
    <table><thead><tr>${headHtml}</tr></thead><tbody>${rowsHtml}</tbody></table>
  `;
  document.body.classList.add('exporting-print');
  window.print();
}
window.addEventListener('afterprint', () => {
  document.body.classList.remove('exporting-print');
  const area = document.getElementById('printExportArea');
