// Fresh / Renewal split of a deal-count bucket. Buckets carry f_count/f_jda/f_jds (the fresh part) once the
// pipeline has run with the split; renewal = total - fresh. Older data has totals only (Fresh + Renewal).
function scenarioCounts(b) {
  if (currentScenario === 'all' || b.f_count === undefined) return { count: b.count, jda: b.jda_count, jds: b.jds_count };
  if (currentScenario === 'fresh') return { count: b.f_count, jda: b.f_jda, jds: b.f_jds };
  return { count: b.count - b.f_count, jda: b.jda_count - b.f_jda, jds: b.jds_count - b.f_jds };
}
let _dealSplitAvail = null;
function dealSplitAvailable() {
  if (_dealSplitAvail !== null) return _dealSplitAvail;
  const src = DAILY.sub_vertical_by_day || DAILY.sales_group_by_day || {};
  for (const pm of Object.values(src)) for (const m of Object.values(pm)) for (const b of Object.values(m)) return (_dealSplitAvail = b.f_count !== undefined);
  return (_dealSplitAvail = false);
}
function dealsScenarioNote() {
  if (currentScenario === 'all') return '';
  if (!dealSplitAvailable()) return ' (Fresh + Renewal: the Fresh/Renewal split arrives with the next data refresh)';
  return currentScenario === 'fresh' ? ' (Fresh only)' : ' (Renewal only)';
}
function computeSalesGroupsForPincode(pincode, fromDate, toDate) {
  const days = daysBetween(fromDate, toDate);
  const counts = {}; // sg -> {count, jda_count, jds_count}
  days.forEach(day => {
    const sgmap = ((DAILY.sales_group_by_day || {})[day] || {})[pincode];
    if (!sgmap) return;
    Object.entries(sgmap).forEach(([sg, b]) => {
      const v = scenarioCounts(b);
      if (!v.count) return;
      const acc = counts[sg] = counts[sg] || { count: 0, jda_count: 0, jds_count: 0 };
      acc.count += v.count; acc.jda_count += v.jda; acc.jds_count += v.jds;
    });
  });
  const total = Object.values(counts).reduce((a, b) => a + b.count, 0);
  if (!total) return null;
  const ranked = Object.entries(counts).sort((a, b) => b[1].count - a[1].count);
  const top = ranked.slice(0, 5);
  const otherCount = total - top.reduce((a, [, b]) => a + b.count, 0);
  const otherJda = Object.values(counts).reduce((a, b) => a + b.jda_count, 0) - top.reduce((a, [, b]) => a + b.jda_count, 0);
  const otherJds = Object.values(counts).reduce((a, b) => a + b.jds_count, 0) - top.reduce((a, [, b]) => a + b.jds_count, 0);
  return {
    total,
    top: top.map(([sg, b]) => ({ sales_group: sg, count: b.count, jda_count: b.jda_count, jds_count: b.jds_count, pct: Math.round(1000 * b.count / total) / 10 })),
    other_count: otherCount,
    other_jda_count: otherJda,
    other_jds_count: otherJds,
    other_pct: otherCount ? Math.round(1000 * otherCount / total) / 10 : 0,
  };
}
function computeMonetizableSalesGroupsForPincode(pincode) {
  const sgmap = (typeof MONETIZABLE_SALES_GROUPS !== 'undefined') ? MONETIZABLE_SALES_GROUPS[pincode] : null;
  if (!sgmap) return null;
  const entries = Object.entries(sgmap); // sg -> {total, paid} -- may already include a server-side
  // 'Other' key (the source data was pre-truncated to top-10+always-keep there). That 'Other'
  // must never compete for a ranked top-5 slot -- it's folded into this function's own residual
  // bucket instead, so there is only ever one coherent "everything else" number, never two.
  const total = entries.reduce((a, [, b]) => a + b.total, 0);
  if (!total) return null;
  const rankable = entries.filter(([sg]) => sg !== 'Other');
  const ranked = rankable.sort((a, b) => b[1].total - a[1].total);
  const top = ranked.slice(0, 5);
  const otherTotal = total - top.reduce((a, [, b]) => a + b.total, 0);
  const otherPaid = entries.reduce((a, [, b]) => a + b.paid, 0) - top.reduce((a, [, b]) => a + b.paid, 0);
  const byName = {};
  entries.forEach(([sg, b]) => { byName[sg] = { count: b.total, paid: b.paid, penetration_pct: b.total ? Math.round(1000 * b.paid / b.total) / 10 : 0 }; });
  return {
    total,
    total_paid: entries.reduce((a, [, b]) => a + b.paid, 0),
    top: top.map(([sg, b]) => ({
      sales_group: sg, count: b.total, paid: b.paid,
      pct: Math.round(1000 * b.total / total) / 10,
      penetration_pct: b.total ? Math.round(1000 * b.paid / b.total) / 10 : 0,
    })),
    other_count: otherTotal,
    other_pct: otherTotal ? Math.round(1000 * otherTotal / total) / 10 : 0,
    other_penetration_pct: otherTotal ? Math.round(1000 * otherPaid / otherTotal) / 10 : 0,
    byName,
  };
}
function penetrationForSalesGroup(pincode, salesGroup, mon) {
  // Looks up paid-penetration for a *deals*-side sales group name against the monetizable-
  // listings breakdown for the same pincode. 'All other' has no single matching entry, so it
  // falls back to monetizable's own 'Other' bucket as the closest analog.
  if (!mon) return null;
  const key = salesGroup === 'All other' ? 'Other' : salesGroup;
  const entry = (mon.byName && mon.byName[key]) || null;
  return entry ? entry.penetration_pct : null;
}
// Display-only label: capitalised first letter, and the residual bucket shown as 'Remaining'
