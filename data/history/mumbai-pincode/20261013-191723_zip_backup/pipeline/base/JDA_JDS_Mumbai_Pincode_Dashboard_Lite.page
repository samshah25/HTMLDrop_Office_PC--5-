function loadColumnOrder() {
  try {
    const saved = JSON.parse(localStorage.getItem('jdaJdsMumbaiDashboardColumnOrder') || 'null');
    if (Array.isArray(saved) && saved.length) {
      const known = saved.filter(k => COLUMN_LABELS[k]);
      const missing = DEFAULT_COLUMN_ORDER.filter(k => !known.includes(k));
      // Insert each missing column right after its default predecessor (if present),
      // so newly-added columns land in their intended spot instead of at the end.
      missing.forEach(k => {
        const defIdx = DEFAULT_COLUMN_ORDER.indexOf(k);
        const predecessor = DEFAULT_COLUMN_ORDER[defIdx - 1];
        const insertAt = predecessor && known.includes(predecessor) ? known.indexOf(predecessor) + 1 : known.length;
        known.splice(insertAt, 0, k);
      });
      return known;
    }
  } catch (e) {}
  return DEFAULT_COLUMN_ORDER.slice();
}
function loadHiddenColumns() {
  try {
    const saved = JSON.parse(localStorage.getItem('jdaJdsMumbaiDashboardHiddenColumns') || 'null');
    if (Array.isArray(saved)) return new Set(saved);
  } catch (e) {}
  return new Set(DEFAULT_HIDDEN_COLUMNS);
}
function saveColumnPrefs() {
  try {
    localStorage.setItem('jdaJdsMumbaiDashboardColumnOrder', JSON.stringify(columnOrder));
    localStorage.setItem('jdaJdsMumbaiDashboardHiddenColumns', JSON.stringify(Array.from(hiddenColumns)));
  } catch (e) {}
}
