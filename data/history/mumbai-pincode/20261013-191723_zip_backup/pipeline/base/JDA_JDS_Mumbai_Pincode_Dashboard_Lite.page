      <span class="col-drag-handle" title="Drag to reorder">⠿</span>
      <label><input type="checkbox" class="col-visible" data-k="${k}" ${hiddenColumns.has(k) ? '' : 'checked'}> ${COLUMN_LABELS[k]}</label>
    </div>
  `).join('') + `<button id="resetColumnsBtn" class="mini-btn" style="margin-top:8px;">Reset to default columns</button>`;
  document.querySelectorAll('#columnPanel .col-visible').forEach(cb => {
    cb.addEventListener('change', (e) => {
      const k = e.target.dataset.k;
      if (e.target.checked) hiddenColumns.delete(k);
      else {
        if (columnOrder.filter(c => !hiddenColumns.has(c)).length <= 1) { e.target.checked = true; return; }
        hiddenColumns.add(k);
      }
      saveColumnPrefs(); renderTableHead(); renderTable(currentRows);
    });
  });
  let dragSrcIdx = null;
  document.querySelectorAll('#columnPanel .column-row').forEach(row => {
    row.addEventListener('dragstart', (e) => {
      dragSrcIdx = parseInt(row.dataset.idx, 10);
      e.dataTransfer.effectAllowed = 'move';
      row.classList.add('dragging');
    });
    row.addEventListener('dragend', () => {
      row.classList.remove('dragging');
      document.querySelectorAll('#columnPanel .column-row').forEach(r => r.classList.remove('drag-over-top', 'drag-over-bottom'));
    });
    row.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      const targetIdx = parseInt(row.dataset.idx, 10);
      row.classList.remove('drag-over-top', 'drag-over-bottom');
      if (dragSrcIdx !== null && targetIdx !== dragSrcIdx) {
        row.classList.add(targetIdx < dragSrcIdx ? 'drag-over-top' : 'drag-over-bottom');
      }
    });
    row.addEventListener('dragleave', () => {
      row.classList.remove('drag-over-top', 'drag-over-bottom');
    });
    row.addEventListener('drop', (e) => {
      e.preventDefault();
      row.classList.remove('drag-over-top', 'drag-over-bottom');
      const targetIdx = parseInt(row.dataset.idx, 10);
      if (dragSrcIdx === null || dragSrcIdx === targetIdx) return;
      const moved = columnOrder.splice(dragSrcIdx, 1)[0];
      columnOrder.splice(targetIdx, 0, moved);
      dragSrcIdx = null;
      saveColumnPrefs(); renderColumnPanel(); renderTableHead(); renderTable(currentRows);
    });
  });
  document.getElementById('resetColumnsBtn').addEventListener('click', () => {
    columnOrder = DEFAULT_COLUMN_ORDER.slice();
    hiddenColumns = new Set(DEFAULT_HIDDEN_COLUMNS);
    saveColumnPrefs(); renderColumnPanel(); renderTableHead(); renderTable(currentRows);
  });
}

function attachHeaderSortHandlers() {
