const OP_OPTIONS = ['>','>=','<','<=','='];

function round1(n) { return Math.round(n * 10) / 10; }
function round2(n) { return Math.round(n * 100) / 100; }

function daysBetween(fromDate, toDate) {
  const days = [];
  let d = new Date(fromDate + 'T00:00:00Z');
  const end = new Date(toDate + 'T00:00:00Z');
  while (d <= end) {
    days.push(d.toISOString().slice(0, 10));
    d.setUTCDate(d.getUTCDate() + 1);
  }
  return days;
}
const MAIN_PINCODES_SET = new Set(DATA.main_pincodes);
function pincodesForCityScope(cityScope) {
  if (cityScope === 'main') return DATA.union_pincodes.filter(p => MAIN_PINCODES_SET.has(p));
  if (cityScope === 'remote') return DATA.union_pincodes.filter(p => !MAIN_PINCODES_SET.has(p));
  return DATA.union_pincodes;
}
function buildRows(scenario, fromDate, toDate, cityScope) {
  cityScope = cityScope || 'both';
  const days = daysBetween(fromDate, toDate);
  const refDate = toDate;
  return pincodesForCityScope(cityScope).map(p => {
    let jda_sales = 0, jds_sales = 0, b2b_count = 0, anonymous_count = 0, total_closed = 0;
    let rv3yr_sum = 0, original_budget_sum = 0, jds_rv3yr_sum = 0, jds_original_budget_sum = 0;
    const team_breakdown = {};
    days.forEach(day => {
      const b = (DAILY.daily_deals[scenario][day] || {})[p];
      if (!b) return;
      jda_sales += b.jda_sales; jds_sales += b.jds_sales;
      b2b_count += b.b2b_count; anonymous_count += b.anonymous_count;
      total_closed += b.total_closed;
      rv3yr_sum += b.rv3yr_sum; original_budget_sum += b.original_budget_sum;
      jds_rv3yr_sum += b.jds_rv3yr_sum; jds_original_budget_sum += b.jds_original_budget_sum;
      Object.entries(b.team_breakdown || {}).forEach(([k, v]) => { team_breakdown[k] = (team_breakdown[k] || 0) + v; });
    });
    let presentation_count = 0;
    const employeeSet = new Set();
    let last_date = null;
    days.forEach(day => {
      const pb = (DAILY.daily_presence[day] || {})[p];
      if (!pb) return;
      presentation_count += pb.count;
      (pb.employees || []).forEach(e => employeeSet.add(e));
      if (pb.last_date && (!last_date || pb.last_date > last_date)) last_date = pb.last_date;
    });
    const jda_present = presentation_count > 0;
    const is_gap = jda_present && jda_sales === 0 && jds_sales > 0;
    const conversion_rate_pct = presentation_count ? round1(100 * jda_sales / presentation_count) : null;
    let days_since_last_jda_visit = null;
    if (last_date) days_since_last_jda_visit = Math.round((new Date(refDate) - new Date(last_date)) / 86400000);
    const row = {
      pincode: p, jda_present, jda_sales, jds_sales, b2b_count, anonymous_count, total_closed,
      rv3yr_sum: round2(rv3yr_sum), original_budget_sum: round2(original_budget_sum),
      jds_rv3yr_sum: round2(jds_rv3yr_sum), jds_original_budget_sum: round2(jds_original_budget_sum),
      team_breakdown, presentation_count, distinct_jda_employees: employeeSet.size,
      conversion_rate_pct, days_since_last_jda_visit, last_jda_visit_date: last_date,
      is_gap,
    };
    row.total_sales = round2(row.jda_sales + row.jds_sales);
    STATIC_ONLY_FIELDS.forEach(f => { row[f] = (DATA.pincode_static[p] || {})[f]; });
    row.deployed_jda_count = deployedCountFor(p, fromDate, toDate);
    row.deployed_presentations = deployedPresentationsFor(p, fromDate, toDate);
    return row;
  });
}

function fmtINR(n) { if (n === null || n === undefined) return '—'; return '₹' + Math.round(n).toLocaleString('en-IN'); }
function fmtPct(n) { return (n === null || n === undefined) ? '—' : n.toFixed(1) + '%'; }
function fmtDays(n) { return (n === null || n === undefined) ? '—' : n + 'd'; }

function jdaShare(row) {
  const total = row.jda_sales + row.jds_sales;
  return total > 0 ? row.jda_sales / total : null;
}

// classify a row into exactly one of the 8 layers
function layerOf(row) {
  if (row.is_gap) return 'gap';
  if (row.jda_sales > 0 && row.jds_sales > 0) {
    const sharePct = jdaShare(row) * 100;
    // One band (default): band2 = everything above cutoff 1 and band3 is empty. Two bands: 1 / 2 / 3.
    const t1 = cutoffs[1], t2 = bandsShown >= 2 ? Math.max(cutoffs[2], t1) : Infinity;
    if (sharePct <= t1) return 'band1';
    if (sharePct <= t2) return 'band2';
    return 'band3';
  }
  if (row.jda_sales > 0 && row.jds_sales === 0) return 'jdaonly';
  if (row.jda_present && row.jda_sales === 0 && row.jds_sales === 0) return 'nosales';
  if (row.jds_sales === 0) return 'outside'; // repurposed: no JDA presence, no sales by anyone
  return 'notpresent'; // redefined: no JDA presence, but JDS is selling here
}
function layerLabel(key) { return LAYER_LABELS()[key]; }

const EMPH = new Set(['gap', 'notpresent']);

let mapTileLayer = null;
function initMap() {
  if (!MAP_ENABLED) return;
  map = L.map('map', {scrollWheelZoom:true, renderer: L.svg(), attributionControl:false}).setView([19.09, 72.88], 11);
  map.getContainer().style.background = '#0b0f18';
  mapTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
    attribution: 'Esri, HERE, Garmin, &copy; OpenStreetMap contributors', maxZoom: 16, opacity: 0.85
  }).addTo(map);
  polygonLayer = L.layerGroup().addTo(map);
  markersLayer = L.layerGroup().addTo(map);
}

function popupHtml(row, key) {
  const teamHtml = Object.entries(row.team_breakdown || {}).map(([k,v]) => `<div><span>${k}</span><span>${v}</span></div>`).join('');
  const placeName = row.geo && row.geo.sample_place ? row.geo.sample_place : (row.area_name || '');
  return `
    <b>${row.pincode}</b> ${placeName ? '('+placeName+')' : ''} ${row.has_boundary ? '<span style="color:#34c77b;font-size:11px;">● real boundary</span>' : '<span style="color:#9aa7bd;font-size:11px;">● geocoded centroid</span>'}<br>
    <b>${layerLabel(key)}</b><br>
    JDA sales: ${row.jda_sales} &nbsp; JDS sales: ${row.jds_sales} &nbsp; JDA share: ${jdaShare(row)!==null ? (jdaShare(row)*100).toFixed(1)+'%' : '—'} &nbsp; Conversion: ${fmtPct(row.conversion_rate_pct)}<br>
    B2B: ${row.b2b_count} &nbsp; Anonymous: ${row.anonymous_count}<br>
    JDA presentations: ${row.presentation_count} (${row.distinct_jda_employees} reps) &nbsp; Last visit: ${fmtDays(row.days_since_last_jda_visit)} ago<br>
    Total RV 3yr (all teams incl. JDA/JDS/B2B/Anonymous): ${fmtINR(row.rv3yr_sum)} &nbsp; Total Original Budget (all teams): ${fmtINR(row.original_budget_sum)}<br>
    Monetizable listings: ${row.monetizable_listings ?? '—'}<br>
    <div class="popup-team">${teamHtml || '<i>no JDS team data</i>'}</div>
  `;
}

function renderMap(rows) {
  if (!MAP_ENABLED) return;
  markersLayer.clearLayers();
  polygonLayer.clearLayers();
  const rowByPincode = {};
  rows.forEach(r => rowByPincode[r.pincode] = r);
  const boundsPts = [];
  const anyOff = LAYER_KEYS.some(k => !layerVisible[k]);

  BOUNDARIES.features.forEach(feat => {
    const pin = feat.properties.pincode;
    const row = rowByPincode[pin];
    if (!row) return;
    row.has_boundary = true;
    row.area_name = feat.properties.area_name;
    const key = layerOf(row);
    if (!layerVisible[key]) return;
    const fillColor = COLORS[key];
    const borderColor = EMPH.has(key) ? darkenHex(fillColor, 0.35) : '#0f1420';
    const borderWeight = EMPH.has(key) ? 2.5 : 1;
    const layer = L.geoJSON(feat, { style: { color: borderColor, weight: borderWeight, fillColor, fillOpacity: EMPH.has(key) ? 0.9 : 0.7 } });
    layer.bindPopup(popupHtml(row, key));
    layer.on('click', () => renderDetail(row, key));
    polygonLayer.addLayer(layer);
    if (row.geo) boundsPts.push([row.geo.lat, row.geo.lon]);
  });

  rows.forEach(row => {
    if (BOUNDARY_PINCODES.has(row.pincode)) return;
    if (!row.geo) return;
    row.has_boundary = false;
    const key = layerOf(row);
    if (!layerVisible[key]) return;
    const radius = 4 + Math.sqrt(row.total_closed + row.presentation_count*0.2) * 1.6;
    const isEmph = EMPH.has(key);
    const fillColor = COLORS[key];
    const markerBorder = isEmph ? darkenHex(fillColor, 0.35) : fillColor;
    const m = L.circleMarker([row.geo.lat, row.geo.lon], {
      radius: isEmph ? radius + 2 : radius, color: markerBorder, fillColor,
      fillOpacity: isEmph ? 0.9 : 0.65, weight: isEmph ? 2.5 : 1, dashArray: isEmph ? null : '2,3'
    });
    m.bindPopup(popupHtml(row, key));
    m.on('click', () => renderDetail(row, key));
    markersLayer.addLayer(m);
    boundsPts.push([row.geo.lat, row.geo.lon]);
  });

  if (anyOff && boundsPts.length) {
    map.fitBounds(boundsPts, {padding: [30, 30], maxZoom: 13});
  } else if (!anyOff) {
    map.setView([19.09, 72.88], 11);  // whole-Mumbai view when every category is shown
  }
}

function renderDetail(row, key) {
  if (!document.getElementById('detailPanel')) return;
  lastClicked = {row, key};
  const teamRows = Object.entries(row.team_breakdown || {})
    .sort((a,b)=>b[1]-a[1])
    .map(([k,v]) => `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--border);"><span>${k}</span><b>${v}</b></div>`)
    .join('');
  const repRows = (row.rep_breakdown || [])
    .map(r => `<div class="rep-row"><span>${r.employee_name || r.employee_id}</span><span>${r.presentations} pres. / ${r.jda_sales} sales</span></div>`)
    .join('');
  document.getElementById('detailPanel').innerHTML = `
    <div style="font-size:14px;margin-bottom:6px;"><b>${row.pincode}</b> ${row.geo && row.geo.sample_place ? '('+row.geo.sample_place+')' : ''} — <span class="badge ${key==='gap'?'badge-gap':''}">${layerLabel(key)}</span></div>
    <div>JDA sales: <b>${row.jda_sales}</b> &nbsp; JDS sales: <b>${row.jds_sales}</b> &nbsp; Total: <b>${row.total_sales}</b> &nbsp; JDA share: <b>${jdaShare(row)!==null ? (jdaShare(row)*100).toFixed(1)+'%' : '—'}</b> &nbsp; Conversion: <b>${fmtPct(row.conversion_rate_pct)}</b></div>
    <div>JDA presentations: <b>${row.presentation_count}</b> by <b>${row.distinct_jda_employees}</b> rep(s)</div>
    <div>Last JDA visit: <b>${fmtDays(row.days_since_last_jda_visit)} ago</b> ${row.last_jda_visit_date ? '('+row.last_jda_visit_date+')' : ''}</div>
    <div>Total RV 3yr (all teams — JDA+JDS+B2B+Anonymous): <b>${fmtINR(row.rv3yr_sum)}</b> &nbsp; Total Original Budget (all teams): <b>${fmtINR(row.original_budget_sum)}</b></div>
    <div style="color:#9aa7bd;font-size:12px;">of which JDS-only: <b>${fmtINR(row.jds_rv3yr_sum)}</b> RV 3yr &nbsp; <b>${fmtINR(row.jds_original_budget_sum)}</b> Original Budget</div>
    <div>Monetizable listings: <b>${row.monetizable_listings ?? '—'}</b></div>
    <div style="margin-top:8px;">${teamRows || '<i>no JDS team data for this pincode</i>'}</div>
    <div class="adv-section">
      <h3 style="margin-top:14px;">Rep-level breakdown (advanced)</h3>
      <div>Split-deal rate: <b>${fmtPct(row.split_rate_pct)}</b> (${row.split_count||0} of ${row.total_jda_side_deals||0} JDA-side deals)</div>
      ${repRows || '<i>no JDA rep activity recorded for this pincode</i>'}
    </div>
  `;
}

const CARD_TIPS = {
  gap: 'JDA is visiting these pincodes (real presentations) but hasn’t closed a single sale here — yet JDS is closing deals in the same pincodes anyway. These are the biggest missed-opportunity areas for JDA.',
  notpresent: 'JDA hasn’t made a single valid visit or presentation in these pincodes during this period, but JDS is closing sales here anyway.',
  nosales: 'JDA has visited these pincodes but nobody — neither JDA nor JDS — has closed a sale here yet.',
  jdaonly: 'JDA is closing sales in these pincodes and JDS isn’t selling here at all.',
  band1: () => `Pincodes where both JDA and JDS are selling, but JDA’s share of the total sales here is on the lower side (up to ${cutoffs[1]}%).`,
  band2: () => bandsShown >= 2 ? `Pincodes where both are selling and JDA’s share falls in the middle range (${cutoffs[1]}–${cutoffs[2]}%).` : `Pincodes where both are selling and JDA’s share is above ${cutoffs[1]}%. Use “Split the rest into 2 bands” below to divide it further.`,
  band3: () => `Pincodes where both are selling and JDA’s share is above ${cutoffs[2]}% — JDA is doing relatively well here.`,
  outside: 'No JDA presentation, and nobody — neither JDA nor JDS — has closed a sale here.',
  total: 'How many pincodes are currently showing in the table and map below, based on your filters, period and Fresh/Renewal selection.',
  jdaShare: 'Out of every sale closed by JDA and JDS combined in this period, what percentage JDA closed.',
  conv: 'For every JDA visit/presentation, how often it actually turned into a sale.',
};
function cardShortLabel(k) {
  return {
    gap: 'Gap pincodes', notpresent: 'No JDA presentation, JDS selling', nosales: 'JDA presentations, nobody selling',
    jdaonly: 'JDA-only selling (no JDS)',
    band1: bandsShown >= 2 ? `JDA-share Band 1 (≤${cutoffs[1]}%)` : `JDA share up to ${cutoffs[1]}%`,
    band2: bandsShown >= 2 ? `JDA-share Band 2 (${cutoffs[1]}-${cutoffs[2]}%)` : `JDA share above ${cutoffs[1]}%`,
    band3: `JDA-share Band 3 (>${cutoffs[2]}%)`, outside: 'No presentation, nobody selling (JDA or JDS)',
  }[k];
}
// Short names for the strip (the full explanation stays in each segment's hover tip).
function stripLabel(k) {
  return {
    gap: 'Gap', notpresent: 'No JDA presentation', nosales: 'JDA presenting, no sales', jdaonly: 'JDA only',
    band1: bandsShown >= 2 ? `JDA share ≤${cutoffs[1]}%` : `JDA share ≤${cutoffs[1]}%`,
    band2: bandsShown >= 2 ? `JDA share ${cutoffs[1]}–${cutoffs[2]}%` : `JDA share >${cutoffs[1]}%`,
    band3: `JDA share >${cutoffs[2]}%`, outside: 'No activity',
  }[k];
}
// Display order = the quick-view groups, so each group sits together (stripe, chips, map legend).
const CATEGORY_GROUPS = [['gap', 'notpresent', 'band1'], ['jdaonly', 'band2', 'band3'], ['nosales', 'outside']];
function orderedLayerKeys() {
  const shown = new Set(renderedLayerKeys());
  return CATEGORY_GROUPS.map(g => g.filter(k => shown.has(k))).filter(g => g.length);
}
// Quick views: one click sets a sensible group of categories.
function viewLayers(v) {
  const two = bandsShown >= 2;
  return {
    all: renderedLayerKeys(),
    losing: ['gap', 'notpresent', 'band1'],
    winning: two ? ['jdaonly', 'band3'] : ['jdaonly', 'band2'],
    nosales: ['nosales', 'outside'],
  }[v];
}
function applyView(v) {
  const on = new Set(viewLayers(v));
  LAYER_KEYS.forEach(k => { layerVisible[k] = on.has(k) || (bandsShown < 2 && k === 'band3'); });
  refreshAll();
}
function syncViewSeg() {
  const seg = document.getElementById('viewSeg'); if (!seg) return;
  const shown = renderedLayerKeys().filter(k => layerVisible[k]).sort().join();
  seg.querySelectorAll('button').forEach(b => b.classList.toggle('active', viewLayers(b.dataset.view).slice().sort().join() === shown));
}
// Categories that exist as cards right now (Band 3 only exists once the rest is split into 2 bands).
function renderedLayerKeys() { return LAYER_KEYS.filter(k => bandsShown >= 2 || k !== 'band3'); }
function renderCards(rows) {
  // Counts come from every pincode that passes the other filters, so a hidden card still shows
  // how many pincodes it would bring back. Totals below use only what is shown.
  const all = currentBaseRows.length ? currentBaseRows : rows;
  const counts = {}; LAYER_KEYS.forEach(k => counts[k] = 0);
  all.forEach(r => counts[layerOf(r)]++);
  const totalJdaSales = rows.reduce((s,r)=>s+r.jda_sales,0);
  const totalJdsSales = rows.reduce((s,r)=>s+r.jds_sales,0);
  const totalPres = rows.reduce((s,r)=>s+r.presentation_count,0);
  const overallConv = totalPres ? (100*totalJdaSales/totalPres).toFixed(1)+'%' : '—';
  const overallJdaShare = (totalJdaSales+totalJdsSales) ? (100*totalJdaSales/(totalJdaSales+totalJdsSales)).toFixed(1)+'%' : '—';
  const n = v => (Math.round(v * 10) / 10).toLocaleString('en-IN');
  const tipOf = (k) => { const t = CARD_TIPS[k]; return (typeof t === 'function' ? t() : t) || ''; };
  // One segment per category, width in proportion to its pincode count (min width keeps small ones clickable).
  const layerCard = (k) => `<button type="button" class="card layer-card ${layerVisible[k]?'':'layer-off'}" data-layer="${k}" aria-pressed="${layerVisible[k] ? 'true' : 'false'}" aria-label="${cardShortLabel(k)}: ${counts[k]} pincodes, ${layerVisible[k] ? 'shown' : 'hidden'}. Click to ${layerVisible[k] ? 'hide' : 'show'}." data-tip="${tipOf(k).replace(/"/g,'&quot;')}" style="--grow:${Math.max(counts[k], 1)}"><div class="num" style="color:var(--cat-${k})">${counts[k]}</div><div class="lbl">${stripLabel(k)}</div></button>`;
  document.getElementById('cards').innerHTML = orderedLayerKeys().map((g, gi) => g.map((k, i) => layerCard(k).replace('class="card layer-card', `class="card layer-card${gi && !i ? ' grp-start' : ''}`)).join('')).join('');
  document.getElementById('stripBar').innerHTML = orderedLayerKeys().map((g, gi) => g.map((k, i) => `<span data-layer="${k}" class="${layerVisible[k] ? '' : 'off'}${gi && !i ? ' grp-start' : ''}" style="--key:var(--cat-${k}); --grow:${Math.max(counts[k], 1)}" title="${stripLabel(k)}: ${counts[k]}"></span>`).join('')).join('');
  document.getElementById('kpis').innerHTML = `
    <span class="kpi" data-tip="${tipOf('total').replace(/"/g,'&quot;')}"><b>${rows.length}</b>of ${DATA.union_pincodes.length} pincodes shown</span>
    <span class="kpi" data-tip="${tipOf('jdaShare').replace(/"/g,'&quot;')}"><b>${overallJdaShare}</b>JDA share of sales (${n(totalJdaSales)} JDA vs ${n(totalJdsSales)} JDS)</span>
    <span class="kpi" data-tip="${tipOf('conv').replace(/"/g,'&quot;')}"><b>${overallConv}</b>JDA conversion (${n(totalJdaSales)} sales from ${n(totalPres)} presentations)</span>`;
  syncViewSeg();
  const hidden = orderedLayerKeys().flat().filter(k => !layerVisible[k]);
  const note = document.getElementById('hiddenCatNote');
  if (hidden.length) {
    const hiddenPins = hidden.reduce((a, k) => a + counts[k], 0);
    note.innerHTML = `<b>${hiddenPins} pincodes hidden</b> <span class="hc-names">(${hidden.map(stripLabel).join(', ')})</span>
      <button class="mini-btn" id="showAllCatsBtn">Show all</button>`;
    note.style.display = '';
  } else {
    note.innerHTML = ''; note.style.display = 'none';
  }
}

