const BOUNDARY_PINCODES = new Set(DATA.pincodes_with_boundary);
// ---------------- JDA deployment (Sept snapshot, uploaded separately) ----------------
function isDeploymentPeriodActive(fromDate, toDate) {
  return fromDate >= DAILY.sept_start && toDate <= DAILY.sept_end;
}
function deployedJdasFor(pincode, fromDate, toDate) {
  if (!isDeploymentPeriodActive(fromDate, toDate)) return [];
  return (JDA_DEPLOYMENT.deployed[pincode] || []);
}
function deployedDetailFor(pincode, fromDate, toDate) {
  const emps = deployedJdasFor(pincode, fromDate, toDate);
  const totals = {};
  daysBetween(fromDate, toDate).forEach(day => {
    const dayData = (DAILY.sept_daily_rep[day] || {})[pincode];
    if (!dayData) return;
    Object.entries(dayData).forEach(([empId, v]) => {
      const t = totals[empId] || (totals[empId] = { presentations: 0, jda_sales: 0 });
      t.presentations += v.presentations;
      t.jda_sales += v.jda_sales;
    });
  });
  return emps.map(e => {
    const hit = totals[e.id];
    return { id: e.id, name: e.name, presentations: hit ? hit.presentations : 0, jda_sales: hit ? round2(hit.jda_sales) : 0 };
  });
}
function deployedCountFor(pincode, fromDate, toDate) { return deployedJdasFor(pincode, fromDate, toDate).length; }
function deployedPresentationsFor(pincode, fromDate, toDate) {
  return deployedDetailFor(pincode, fromDate, toDate).reduce((s, d) => s + d.presentations, 0);
}
const MONTHS = DATA.months;
const SHORT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTH_NAMES = {};
const MONTH_END_DATE = {};
MONTHS.forEach(m => {
  const [y, mo] = m.split('-').map(Number);
  MONTH_NAMES[m] = SHORT_MONTHS[mo - 1] + ' ' + y;
  const lastDay = new Date(y, mo, 0).getDate();
  let endDate = `${y}-${String(mo).padStart(2,'0')}-${String(lastDay).padStart(2,'0')}`;
  if (DAILY.window_end && m === MONTHS[MONTHS.length - 1] && DAILY.window_end < endDate) endDate = DAILY.window_end;
  MONTH_END_DATE[m] = endDate;
});
const STATIC_ONLY_FIELDS = ['geo','rep_breakdown','split_rate_pct','split_count','total_jda_side_deals','monetizable_listings','state'];

const DEFAULT_COLORS = {
  gap: '#a855f7', notpresent: '#9b1b43', nosales: '#5b6577', jdaonly: '#22c55e',
  band1: '#ef4444', band2: '#3b82f6', band3: '#22c55e', outside: '#14b8a6',
};
const LAYER_KEYS = ['gap','notpresent','nosales','jdaonly','band1','band2','band3','outside'];
let COLORS = loadColors();
let layerVisible = {}; LAYER_KEYS.forEach(k => layerVisible[k] = true);
// Prima facie: only Band 1 is shown among the JDA-share bands; Band 2/3 and
// "above bands" stay available via the layer cards but start hidden so the
// map/table aren't cluttered with every share tier at once.
// Mumbai: open on 'All pincodes' -- nothing hidden by default (Sarvesh, 2026-09-25).
let cutoffs = { 1: 20, 2: 30, 3: 40 };  // Mumbai: two bands only, <=20% and >20% (only cutoffs[1] is used)

function loadColors() {
  try {
    const saved = JSON.parse(localStorage.getItem('jdaJdsMumbaiDashboardColors') || '{}');
    if (String(saved.notpresent || '').toLowerCase() === '#ff1493') delete saved.notpresent;  // old default (hot pink) -> new burgundy
    return Object.assign({}, DEFAULT_COLORS, saved);
  }
  catch (e) { return Object.assign({}, DEFAULT_COLORS); }
}
function saveColors() { try { localStorage.setItem('jdaJdsMumbaiDashboardColors', JSON.stringify(COLORS)); } catch (e) {} }
function applyColorsToCSS() {
  const root = document.documentElement.style;
  LAYER_KEYS.forEach(k => root.setProperty('--cat-'+k, COLORS[k]));
}
function darkenHex(hex, amount) {
  const m = hex.replace('#','');
  const r = parseInt(m.substring(0,2),16), g = parseInt(m.substring(2,4),16), b = parseInt(m.substring(4,6),16);
  const f = (c) => Math.max(0, Math.round(c * (1 - amount)));
  return '#' + [f(r),f(g),f(b)].map(x => x.toString(16).padStart(2,'0')).join('');
}

const LAYER_LABELS = () => ({
  gap: 'Gap (JDA presentations, 0 JDA sales, JDS selling)',
