// Quick ranges, all relative to the last day with data (DAILY.window_end).
function periodPresets() {
  const iso = d => d.toISOString().slice(0, 10);
  const end = new Date(DAILY.window_end + 'T00:00:00Z');
  const addDays = (d, n) => { const x = new Date(d); x.setUTCDate(x.getUTCDate() + n); return x; };
  const monthStart = d => new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1));
  const lastMonthEnd = addDays(monthStart(end), -1);
  const out = [
    ['thisMonth', 'This month so far', iso(monthStart(end)), DAILY.window_end],
    ['lastMonth', 'Last month', iso(monthStart(lastMonthEnd)), iso(lastMonthEnd)],
    ['last7', 'Last 7 days', iso(addDays(end, -6)), DAILY.window_end],
    ['last30', 'Last 30 days', iso(addDays(end, -29)), DAILY.window_end],
  ];
  // Financial-year quarters (Q1 = Apr–Jun) that overlap the data window.
  const names = ['Apr–Jun', 'Jul–Sep', 'Oct–Dec', 'Jan–Mar'];
  let y = parseInt(DAILY.window_start.slice(0, 4), 10), q = 0;
  for (let guard = 0; guard < 12; guard++) {
    const startM = [3, 6, 9, 0][q], yr = q === 3 ? y + 1 : y;
    const qs = new Date(Date.UTC(yr, startM, 1)), qe = addDays(new Date(Date.UTC(yr, startM + 3, 1)), -1);
    if (iso(qs) > DAILY.window_end) break;
    if (iso(qe) >= DAILY.window_start) out.push([`q${q + 1}-${yr}`, `Q${q + 1} FY${String(y + 1).slice(2)} (${names[q]})`, iso(qs), iso(qe)]);
    q = (q + 1) % 4; if (q === 0) y++;
  }
  return out;
}
(function initPeriodPresets() {
  const sel = document.getElementById('periodPreset');
  if (!sel) return;
  const presets = periodPresets();
  sel.insertAdjacentHTML('beforeend', presets.map(([v, label]) => `<option value="${v}">${label}</option>`).join(''));
  sel.addEventListener('change', () => {
    const p = presets.find(x => x[0] === sel.value);
    sel.value = '';
    if (p) setPeriod(p[2], p[3]);
  });
})();

