    document.getElementById('searchBox').value = '';
    viewAllActive = true;
    btn.textContent = 'Restore my filters';
    setPeriod(DAILY.window_start, DAILY.window_end);
  } else {
    layerVisible = savedViewState.layerVisible;
    columnFilters = savedViewState.columnFilters;
    renderTableHead();
    document.getElementById('searchBox').value = savedViewState.search;
    const restoreFrom = savedViewState.periodFromDate, restoreTo = savedViewState.periodToDate;
    viewAllActive = false;
    btn.textContent = 'Show every pincode';
    savedViewState = null;
    setPeriod(restoreFrom, restoreTo);
  }
});

