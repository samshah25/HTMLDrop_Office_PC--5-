function renderDQ() {
  // Untagged share of deals in the loaded window, computed from the page's own data so it never goes stale.
  let untagged = 0, allDeals = 0;
  Object.values((DAILY.sales_group_by_day) || {}).forEach(pm => Object.values(pm).forEach(m => Object.entries(m).forEach(([k, b]) => {
    allDeals += b.count; if (k === 'Untagged') untagged += b.count;
  })));
  const untaggedPct = allDeals ? (100 * untagged / allDeals).toFixed(1) + '%' : '—';
  document.getElementById('dqNotes').innerHTML = `
    <ul>
      <li><b>Territory:</b> every pincode on the Mumbai-branch list counts, whichever branch closed the deal.</li>
      <li><b>JDA deployed</b> columns and the roster in each pincode's detail come from a September roster uploaded by hand. They show numbers only when the Period is inside September, and they aren't refreshed daily.</li>
      <li><b>Presentations</b> count only when the visit recorded points or revenue. Fresh / Renewal changes sales figures only, not presentations.</li>
      <li><b>Joint deals</b> closed by JDA and JDS together count 0.5 to each, which is why sales can show halves (e.g. 23.5).</li>
      <li><b>Manager figures:</b> a JDA's manager is their “Reporting Manager” on the presentation records. A manager's pincodes are the ones their team presented in or sold in during the selected period, not an assigned list.</li>
      <li><b>Monetizable listings and Paid %</b> are refreshed once a month, so they don't change with the period filter. “Paid” means currently paid.</li>
      <li><b>Untagged</b> (${untaggedPct} of deals) are businesses with no category on file yet, so they can't be placed in a sales group.</li>
    </ul>
  `;
