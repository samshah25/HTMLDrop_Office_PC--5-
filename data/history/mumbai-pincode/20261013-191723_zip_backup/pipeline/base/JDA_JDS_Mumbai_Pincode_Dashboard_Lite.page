const CATEGORICAL_FIELDS = new Set(['pincode', 'place', 'is_gap', 'state']);
let columnFilters = {}; // { field: {type:'numeric', op, value} | {type:'set', values:Set<string>} }
function cloneColumnFilters(cf) {
  const out = {};
  for (const k in cf) {
    const f = cf[k];
    out[k] = f.type === 'set' ? { type: 'set', values: new Set(f.values) } : { type: 'numeric', op: f.op, value: f.value };
  }
  return out;
}

function getBaseRows() {
  const rows = buildRows(currentScenario, periodFromDate, periodToDate, currentCityScope);
  rows.forEach(r => { const s = jdaShare(r); r.jda_share_pct = s === null ? null : s * 100; });
  return rows;
}
function columnValueForFilter(row, field) {
  if (field === 'place') return row.geo && row.geo.sample_place ? row.geo.sample_place : '(no place on file)';
  if (field === 'is_gap') return row.is_gap ? 'Gap' : 'Not gap';
  if (field === 'state') return row.state || '(no state on file)';
  return String(row[field]);
}
function getDistinctValues(field) {
  const set = new Set();
  getBaseRows().forEach(r => set.add(columnValueForFilter(r, field)));
  return Array.from(set).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}
function isColumnFilterActive(field) {
  const f = columnFilters[field];
  if (!f) return false;
  if (f.type === 'numeric') return f.value !== '' && f.value !== null && !isNaN(f.value);
  if (f.type === 'set') return f.values.size < getDistinctValues(field).length;
  return false;
}
function passesColumnFilters(row) {
  for (const field in columnFilters) {
    const f = columnFilters[field];
    if (!f) continue;
    if (f.type === 'numeric') {
      if (f.value === '' || f.value === null || isNaN(f.value)) continue;
      const v = row[field];
      if (v === null || v === undefined) return false;
      const rv = parseFloat(f.value);
      if (f.op === '>' && !(v > rv)) return false;
      if (f.op === '>=' && !(v >= rv)) return false;
      if (f.op === '<' && !(v < rv)) return false;
      if (f.op === '<=' && !(v <= rv)) return false;
      if (f.op === '=' && !(v === rv)) return false;
    } else if (f.type === 'set') {
      if (!f.values.has(columnValueForFilter(row, field))) return false;
    }
  }
  return true;
}

function renderFilterList(rows) {
  document.getElementById('filterListBody').innerHTML = rows
