// ---- Manager & JDA performance: state ----
let perfView = 'manager';
const expandedManagers = new Set();
let pincodeFilterEmployees = null;
// Set when a pincode row is clicked: the performance section then shows only activity AT that
// pincode (within the Period + other filters), i.e. that pincode's figures split by manager / JDA.
let perfPincodeFocus = null;
let savedLayerVisibleBeforeMgrFilter = null;
let perfOpenFilterField = null;
const perfColumnFilters = { manager: {}, jda: {} };
const PERF_CATEGORICAL = new Set(['manager', 'name']);
const PERF_FIELDS = {
  manager: [
    ['manager', 'Manager', false], ['pincodes_covered', 'Pincodes', true], ['gap_pincodes', 'Gap', true],
    ['total_presentations', 'Presentations', true], ['jda_sales', 'JDA Sales', true], ['conversion_rate_pct', 'Conv %', true],
  ],
  jda: [
    ['name', 'JDA', false], ['manager', 'Manager', false], ['pincodes_covered', 'Pincodes', true],
    ['presentations', 'Presentations', true], ['jda_sales', 'JDA Sales', true], ['conversion_rate_pct', 'Conv %', true],
  ],
};
let perfSort = { manager: { field: 'gap_pincodes', dir: -1 }, jda: { field: 'presentations', dir: -1 } };
let currentPerfData = null; // recomputed by refreshPerfData() on every refreshAll() -- Period + every pincode filter

function computePerfData(fromDate, toDate, allowedPins) {
  // allowedPins (Set, optional): only activity in these pincodes counts -- the pincodes currently
  // shown in the pincode table (City scope + category toggles + column filters). empPincodesAll /
  // managerPincodesAll ignore it, so "click a manager" can still show every pincode they cover.
  const days = daysBetween(fromDate, toDate);
  const empPres = {}, empSales = {}, empPincodes = {}, empPincodesAll = {};
  const touch = (emp, p) => { (empPincodes[emp] = empPincodes[emp] || new Set()).add(p); };
  const touchAll = (emp, p) => { (empPincodesAll[emp] = empPincodesAll[emp] || new Set()).add(p); };
  days.forEach(day => {
    const presDay = (DAILY.rep_pin_pres_by_day || {})[day] || {};
    Object.entries(presDay).forEach(([p, empmap]) => {
      const inScope = !allowedPins || allowedPins.has(p);
      Object.entries(empmap).forEach(([emp, c]) => { touchAll(emp, p); if (!inScope) return; empPres[emp] = (empPres[emp] || 0) + c; touch(emp, p); });
    });
    const salesDay = (DAILY.rep_pin_sales_by_day || {})[day] || {};
    Object.entries(salesDay).forEach(([p, empmap]) => {
      const inScope = !allowedPins || allowedPins.has(p);
      Object.entries(empmap).forEach(([emp, s]) => { touchAll(emp, p); if (!inScope) return; empSales[emp] = (empSales[emp] || 0) + s; touch(emp, p); });
    });
  });
  const allEmps = new Set([...Object.keys(empPres), ...Object.keys(empSales)]);
  const employeePerf = Array.from(allEmps).map(emp => {
    const pres = empPres[emp] || 0;
    const sales = Math.round((empSales[emp] || 0) * 100) / 100;
    const meta = EMP_META[emp] || { name: emp, manager: 'Unassigned' };
    return {
      id: emp, name: meta.name, manager: meta.manager,
      pincodes_covered: (empPincodes[emp] || new Set()).size,
      presentations: pres, jda_sales: sales,
      conversion_rate_pct: pres ? Math.round(1000 * sales / pres) / 10 : null,
    };
  });
  const managerTeams = {};
  employeePerf.forEach(e => { (managerTeams[e.manager] = managerTeams[e.manager] || []).push(e); });
  Object.values(managerTeams).forEach(list => list.sort((a, b) => b.presentations - a.presentations));
  const jdaFlat = employeePerf.slice().sort((a, b) => b.presentations - a.presentations);
  const managerPincodeSets = {};
  employeePerf.forEach(e => {
    const s = managerPincodeSets[e.manager] = managerPincodeSets[e.manager] || new Set();
    (empPincodes[e.id] || new Set()).forEach(p => s.add(p));
  });
  const managerPincodes = {};
  Object.entries(managerPincodeSets).forEach(([mgr, s]) => { managerPincodes[mgr] = Array.from(s).sort(); });
  const managerPincodeSetsAll = {};
  Object.entries(empPincodesAll).forEach(([emp, pins]) => {
    const mgr = (EMP_META[emp] || { manager: 'Unassigned' }).manager;
    const s = managerPincodeSetsAll[mgr] = managerPincodeSetsAll[mgr] || new Set();
    pins.forEach(p => s.add(p));
  });
  const managerPincodesAll = {};
  Object.entries(managerPincodeSetsAll).forEach(([mgr, s]) => { managerPincodesAll[mgr] = Array.from(s).sort(); });
  const pincodeEmployeeSets = {};
  days.forEach(day => {
    Object.entries((DAILY.rep_pin_pres_by_day || {})[day] || {}).forEach(([p, empmap]) => {
      if (allowedPins && !allowedPins.has(p)) return;
      const s = pincodeEmployeeSets[p] = pincodeEmployeeSets[p] || new Set();
      Object.keys(empmap).forEach(e => s.add(e));
    });
    Object.entries((DAILY.rep_pin_sales_by_day || {})[day] || {}).forEach(([p, empmap]) => {
      if (allowedPins && !allowedPins.has(p)) return;
      const s = pincodeEmployeeSets[p] = pincodeEmployeeSets[p] || new Set();
      Object.keys(empmap).forEach(e => s.add(e));
    });
  });
  const pincodeEmployees = {};
  Object.entries(pincodeEmployeeSets).forEach(([p, s]) => { pincodeEmployees[p] = Array.from(s).sort(); });
  const gapRows = buildRows('all', fromDate, toDate, 'both');
  const gapSet = new Set(gapRows.filter(r => r.is_gap).map(r => r.pincode));
  const managerRollup = Object.entries(managerTeams).map(([mgr, team]) => {
    const pinsArr = managerPincodes[mgr] || [];
    const pres_c = team.reduce((a, e) => a + e.presentations, 0);
    const sales_c = team.reduce((a, e) => a + e.jda_sales, 0);
    const gapCount = pinsArr.reduce((a, p) => a + (gapSet.has(p) ? 1 : 0), 0);
    return {
      manager: mgr, pincodes_covered: pinsArr.length, gap_pincodes: gapCount,
      total_presentations: pres_c, jda_sales: Math.round(sales_c * 10) / 10,
      conversion_rate_pct: pres_c ? Math.round(10000 * sales_c / pres_c) / 100 : null,
    };
  }).sort((a, b) => b.gap_pincodes - a.gap_pincodes);
  return { employeePerf, managerTeams, jdaFlat, managerPincodes, managerPincodesAll, pincodeEmployees, managerRollup };
}
function refreshPerfData() {
  const shown = new Set(currentRows.map(r => r.pincode));
  const allowed = perfPincodeFocus ? new Set(shown.has(perfPincodeFocus) ? [perfPincodeFocus] : []) : shown;
  currentPerfData = computePerfData(periodFromDate, periodToDate, allowed);
  if (perfPincodeFocus) {
    expandedManagers.clear();  // managers stay collapsed; open a manager (or Expand all) to see the JDAs
    renderPincodeFocusBadge();
  }
}

function fmtNum(n) { return (n === null || n === undefined) ? '—' : n; }
function perfSearchMatch(text, q) { return !q || String(text || '').toLowerCase().includes(q); }
function perfSourceRows(view) { return view === 'manager' ? currentPerfData.managerRollup : currentPerfData.jdaFlat; }
function perfDistinctValues(field) {
  const set = new Set();
  perfSourceRows(perfView).forEach(r => set.add(String(r[field])));
  return Array.from(set).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
}
function perfPassesColumnFilters(row) {
  const filters = perfColumnFilters[perfView];
  for (const field in filters) {
    const f = filters[field];
    if (!f) continue;
    if (f.type === 'numeric') {
      if (f.value === '' || f.value === null || isNaN(f.value)) continue;
      const v = row[field];
      if (v === null || v === undefined) return false;
      const rv = parseFloat(f.value);
      if (f.op === '>' && !(v > rv)) return false;
      if (f.op === '>=' && !(v >= rv)) return false;
      if (f.op === '<' && !(v < rv)) return false;
      if (f.op === '<=' && !(v <= rv)) return false;
      if (f.op === '=' && !(v === rv)) return false;
    } else if (f.type === 'set') {
      if (!f.values.has(String(row[field]))) return false;
    }
  }
  return true;
}
function perfIsFilterActive(field) {
  const f = perfColumnFilters[perfView][field];
  if (!f) return false;
  if (f.type === 'numeric') return f.value !== '' && f.value !== null && !isNaN(f.value);
  if (f.type === 'set') return f.values.size < perfDistinctValues(field).length;
  return false;
}
function applyPerfSort(rows) {
  const s = perfSort[perfView];
  return rows.slice().sort((a, b) => {
    const av = a[s.field], bv = b[s.field];
    if (!PERF_CATEGORICAL.has(s.field)) {
      const an = av === null || av === undefined ? -Infinity : av;
      const bn = bv === null || bv === undefined ? -Infinity : bv;
      return (an - bn) * s.dir;
    }
    return String(av || '').localeCompare(String(bv || '')) * s.dir;
  });
}
function perfHeaderCellHtml(field, label, numeric) {
  const s = perfSort[perfView];
  const ind = s.field === field ? (s.dir === 1 ? '↑' : '↓') : '';
  const active = perfIsFilterActive(field);
  return `<th data-field="${field}" class="${numeric ? 'num-col' : ''}"><span class="th-label">${label}</span><span class="th-controls"><span class="sort-ind">${ind}</span><span class="col-filter-icon${active ? ' active' : ''}" data-filter-k="${field}" title="Filter this column">▾</span></span></th>`;
}
function perfRenderNumericFilterPopup(field, label) {
  const cur = perfColumnFilters[perfView][field] && perfColumnFilters[perfView][field].type === 'numeric' ? perfColumnFilters[perfView][field] : { op: '>=', value: '' };
  return `
    <div class="cf-title">${label}</div>
    <div class="cf-row">
      <select id="pcfOp">${OP_OPTIONS.map(o => `<option value="${o}" ${cur.op === o ? 'selected' : ''}>${o}</option>`).join('')}</select>
      <input type="number" id="pcfValue" value="${cur.value}" placeholder="value">
    </div>
    <div class="cf-actions"><button id="pcfApply" class="mini-btn">Apply</button><button id="pcfClear" class="mini-btn">Clear</button></div>
  `;
}
function perfRenderSetFilterPopup(field, label) {
  const values = perfDistinctValues(field);
  const cur = perfColumnFilters[perfView][field] && perfColumnFilters[perfView][field].type === 'set' ? perfColumnFilters[perfView][field].values : new Set(values);
  return `
    <div class="cf-title">${label}</div>
    <input type="text" id="pcfSearch" class="cf-search" placeholder="Search...">
    <label class="cf-item cf-selectall"><input type="checkbox" id="pcfSelectAll" ${cur.size === values.length ? 'checked' : ''}> <b>(Select All)</b></label>
    <div class="cf-list" id="pcfList">${values.map(v => `<label class="cf-item"><input type="checkbox" class="cf-val" value="${escapeHtml(v)}" ${cur.has(v) ? 'checked' : ''}> ${escapeHtml(v)}</label>`).join('')}</div>
    <div class="cf-actions"><button id="pcfApply" class="mini-btn">OK</button><button id="pcfClear" class="mini-btn">Clear</button></div>
  `;
}
function perfCloseColFilterPopup() {
  const p = document.getElementById('perfColFilterPopup');
  if (p) p.style.display = 'none';
  perfOpenFilterField = null;
}
function perfOpenColFilterPopup(field, label, iconEl) {
  perfOpenFilterField = field;
  const p = document.getElementById('perfColFilterPopup');
  p.innerHTML = PERF_CATEGORICAL.has(field) ? perfRenderSetFilterPopup(field, label) : perfRenderNumericFilterPopup(field, label);
  p.style.display = 'block';
  const rect = iconEl.getBoundingClientRect();
  const popW = 230;
  let left = rect.left;
  if (left + popW > window.innerWidth - 10) left = window.innerWidth - popW - 10;
  p.style.top = (rect.bottom + 4) + 'px';
  p.style.left = Math.max(10, left) + 'px';
  perfWireColFilterPopup(field);
}
function perfWireColFilterPopup(field) {
  const p = document.getElementById('perfColFilterPopup');
  p.onclick = (e) => e.stopPropagation();
  if (PERF_CATEGORICAL.has(field)) {
    const selectAll = document.getElementById('pcfSelectAll');
    const search = document.getElementById('pcfSearch');
    selectAll.addEventListener('change', (e) => {
      p.querySelectorAll('.cf-val').forEach(cb => { if (cb.closest('.cf-item').style.display !== 'none') cb.checked = e.target.checked; });
    });
    search.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      p.querySelectorAll('#pcfList .cf-item').forEach(item => { item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none'; });
    });
    document.getElementById('pcfApply').addEventListener('click', () => {
      const values = new Set(Array.from(p.querySelectorAll('.cf-val:checked')).map(cb => cb.value));
      perfColumnFilters[perfView][field] = { type: 'set', values };
      perfCloseColFilterPopup();
      renderPerfView();
    });
  } else {
    document.getElementById('pcfApply').addEventListener('click', () => {
      const op = document.getElementById('pcfOp').value;
      const value = document.getElementById('pcfValue').value;
      perfColumnFilters[perfView][field] = { type: 'numeric', op, value };
      perfCloseColFilterPopup();
      renderPerfView();
    });
  }
  document.getElementById('pcfClear').addEventListener('click', () => {
    delete perfColumnFilters[perfView][field];
    perfCloseColFilterPopup();
    renderPerfView();
  });
}
document.addEventListener('click', (e) => {
  if (perfOpenFilterField && !e.target.closest('.col-filter-icon')) perfCloseColFilterPopup();
});

function clearManagerFilter() {
  delete columnFilters['pincode'];
  if (savedLayerVisibleBeforeMgrFilter) {
    Object.assign(layerVisible, savedLayerVisibleBeforeMgrFilter);
    savedLayerVisibleBeforeMgrFilter = null;
  }
  document.getElementById('mgrFilterBadge').style.display = 'none';
  refreshAll();
}
function filterTableToManager(mgr) {
  const pins = (currentPerfData.managerPincodesAll[mgr]) || [];
  columnFilters['pincode'] = { type: 'set', values: new Set(pins) };
  if (!savedLayerVisibleBeforeMgrFilter) savedLayerVisibleBeforeMgrFilter = Object.assign({}, layerVisible);
  LAYER_KEYS.forEach(k => { layerVisible[k] = true; });
  refreshAll();
  const badge = document.getElementById('mgrFilterBadge');
  badge.style.display = '';
  badge.innerHTML = `Showing all <b>${pins.length}</b> pincode${pins.length === 1 ? '' : 's'} covered by <b>${mgr}</b>'s team (all category filters temporarily turned on) — <a href="#" id="clearMgrFilterLink" style="color:var(--accent);text-decoration:underline;">clear</a>`;
  document.getElementById('clearMgrFilterLink').addEventListener('click', (e) => { e.preventDefault(); clearManagerFilter(); });
  document.querySelector('#dataTable').scrollIntoView({ behavior: 'smooth', block: 'start' });
}
function clearPincodeFilter() {
  perfPincodeFocus = null;
  pincodeFilterEmployees = null;
  document.getElementById('pincodeFilterBadge').style.display = 'none';
  expandedManagers.clear();
  refreshPerfData();
  renderPerfView();
}
function renderPincodeFocusBadge() {
  const badge = document.getElementById('pincodeFilterBadge');
  if (!badge || !perfPincodeFocus) return;
  const emps = currentPerfData.employeePerf;
  const pres = emps.reduce((a, e) => a + e.presentations, 0);
  const sales = Math.round(emps.reduce((a, e) => a + e.jda_sales, 0) * 100) / 100;
  const mgrs = currentPerfData.managerRollup.length;
  badge.style.display = '';
  badge.innerHTML = emps.length
    ? `<b>Pincode ${perfPincodeFocus} only</b> (${periodLabel()}): ${mgrs} manager${mgrs === 1 ? '' : 's'}, ${emps.length} JDA${emps.length === 1 ? '' : 's'}, ${pres} presentations, ${sales} JDA sales. Every figure below is for this pincode alone. <a href="#" id="clearPincodeFilterLink" style="color:var(--accent);text-decoration:underline;">Show all managers</a>`
    : `<b>Pincode ${perfPincodeFocus}</b>: no JDA presentations or JDA sales in ${periodLabel()}${currentRows.some(r => r.pincode === perfPincodeFocus) ? '' : ' (or it is hidden by the filters above)'}. <a href="#" id="clearPincodeFilterLink" style="color:var(--accent);text-decoration:underline;">Show all managers</a>`;
  document.getElementById('clearPincodeFilterLink').addEventListener('click', (e) => { e.preventDefault(); clearPincodeFilter(); });
}
function filterPerfToPincode(pincode) {
  perfPincodeFocus = pincode;
  pincodeFilterEmployees = null;
  perfView = 'manager';
  document.querySelectorAll('#perfViewSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === 'manager'));
  refreshPerfData();
  renderPerfView();
  document.getElementById('perfViewBody').scrollIntoView({ behavior: 'smooth', block: 'center' });
}
document.querySelector('#dataTable tbody').addEventListener('click', (e) => {
  const expandCell = e.target.closest('.pin-expand-cell');
  if (expandCell) {
    const pin = expandCell.dataset.pin;
    if (expandedPincodes.has(pin)) expandedPincodes.delete(pin); else expandedPincodes.add(pin);
    renderTable(currentRows);
    return;
  }
  const row = e.target.closest('tr[data-pincode]');
  if (!row) return;
  filterPerfToPincode(row.dataset.pincode);
});

// ---- deployed vs not-deployed JDAs (Manager & JDA performance) ----
let _deployedIds = null;
function deployedIdSet() {
  if (_deployedIds) return _deployedIds;
  _deployedIds = new Set();
  Object.values(((JDA_DEPLOYMENT || {}).deployed) || {}).forEach(list => list.forEach(e => _deployedIds.add(String(e.id))));
  return _deployedIds;
}
function isDeployedJda(id) { return deployedIdSet().has(String(id)); }
function deployedTag(id) { return isDeployedJda(id) ? ' <span class="dep-tag" title="On the JDA deployment roster">Deployed</span>' : ''; }
function renderDeployCompare(q) {
  const box = document.getElementById('perfDeployCompare');
  if (!box) return;
  if (!deployedIdSet().size) { box.innerHTML = ''; return; }
  const emps = currentPerfData.employeePerf
    .filter(e => !pincodeFilterEmployees || pincodeFilterEmployees.has(e.id))
    .filter(e => !q || perfSearchMatch(e.name, q) || perfSearchMatch(e.manager, q));
  const agg = list => {
    const pres = list.reduce((a, e) => a + e.presentations, 0), sales = Math.round(list.reduce((a, e) => a + e.jda_sales, 0) * 10) / 10;
    return { n: list.length, pres, sales, conv: pres ? (Math.round(1000 * sales / pres) / 10) + '%' : '—' };
  };
  const d = agg(emps.filter(e => isDeployedJda(e.id))), o = agg(emps.filter(e => !isDeployedJda(e.id)));
  const row = (cls, label, a) => `<tr class="${cls}"><td>${label}</td><td class="num-col">${a.n}</td><td class="num-col">${a.pres}</td><td class="num-col">${a.sales}</td><td class="num-col"><b>${a.conv}</b></td></tr>`;
  box.innerHTML = `<table class="dep-compare"><thead><tr><th>Deployed vs not deployed</th><th class="num-col">JDAs</th><th class="num-col">Presentations</th><th class="num-col">JDA sales</th><th class="num-col">Conv %</th></tr></thead><tbody>`
    + row('perf-deployed', 'Deployed JDAs (on the roster)', d) + row('', 'Other JDAs', o)
    + `</tbody></table><div class="note" style="margin:4px 0 10px;">Follows the same filters as the table below. Deployed rows are highlighted.</div>`;
}
function renderPerfView() {
  const body = document.getElementById('perfViewBody');
  if (!body) return;
  const q = (document.getElementById('perfSearchBox').value || '').trim().toLowerCase();
  const fields = PERF_FIELDS[perfView];
  renderDeployCompare(q);

  if (perfView === 'manager') {
    let rows = currentPerfData.managerRollup.filter(m => {
      const team = currentPerfData.managerTeams[m.manager] || [];
      if (pincodeFilterEmployees && !team.some(e => pincodeFilterEmployees.has(e.id))) return false;
      if (!perfPassesColumnFilters(m)) return false;
      if (!q) return true;
      if (perfSearchMatch(m.manager, q)) return true;
      return team.some(e => perfSearchMatch(e.name, q));
    });
    rows = applyPerfSort(rows);
    body.innerHTML = `<table><thead><tr><th></th>${fields.map(([f, l, n]) => perfHeaderCellHtml(f, l, n)).join('')}</tr></thead><tbody>${
      rows.map(m => {
        const team = currentPerfData.managerTeams[m.manager] || [];
        const isOpen = expandedManagers.has(m.manager);
        const teamShown = team.filter(e => !pincodeFilterEmployees || pincodeFilterEmployees.has(e.id));
        const teamRows = isOpen ? teamShown
          .filter(e => !q || perfSearchMatch(m.manager, q) || perfSearchMatch(e.name, q))
          .map(e => `
          <tr class="perf-subrow${isDeployedJda(e.id) ? ' perf-deployed' : ''}">
            <td></td>
            <td style="padding-left:26px;color:var(--text-dim);">${e.name}${deployedTag(e.id)}</td>
            <td class="num-col">${e.pincodes_covered}</td>
            <td class="num-col">—</td>
            <td class="num-col">${e.presentations}</td>
            <td class="num-col">${e.jda_sales}</td>
            <td class="num-col">${fmtNum(e.conversion_rate_pct)}</td>
          </tr>`).join('') : '';
        return `
          <tr class="perf-mgr-row" data-mgr="${String(m.manager).replace(/"/g, '&quot;')}" style="cursor:pointer;">
            <td class="team-toggle-cell">${teamShown.length ? `<button type="button" class="team-toggle${isOpen ? ' open' : ''}" aria-expanded="${isOpen}" title="${isOpen ? 'Hide' : 'Show'} this manager's JDAs">${isOpen ? '▾' : '▸'} ${teamShown.length} JDA${teamShown.length === 1 ? '' : 's'}${(() => { const k = teamShown.filter(e => isDeployedJda(e.id)).length; return k ? `, ${k} deployed` : ''; })()}</button>` : ''}</td>
            <td><a href="#" class="perf-mgr-link" data-mgr="${String(m.manager).replace(/"/g, '&quot;')}" style="color:var(--accent);text-decoration:none;" title="Click to filter the pincode table above to this manager's team"><b>${m.manager}</b></a></td>
            <td class="num-col">${m.pincodes_covered}</td>
            <td class="num-col">${m.gap_pincodes}</td>
            <td class="num-col">${m.total_presentations}</td>
            <td class="num-col">${m.jda_sales}</td>
            <td class="num-col">${fmtNum(m.conversion_rate_pct)}</td>
          </tr>${teamRows}`;
      }).join('')
    }</tbody></table>`;
    const expBtn = document.getElementById('expandAllManagersBtn');
    const openable = rows.filter(m => (currentPerfData.managerTeams[m.manager] || []).length);
    expBtn.style.display = openable.length ? '' : 'none';
    expBtn.textContent = openable.length && openable.every(m => expandedManagers.has(m.manager)) ? 'Collapse all' : 'Expand all';
  } else {
    document.getElementById('expandAllManagersBtn').style.display = 'none';
    let rows = currentPerfData.jdaFlat.filter(e => !pincodeFilterEmployees || pincodeFilterEmployees.has(e.id));
    rows = rows.filter(e => perfPassesColumnFilters(e));
    rows = rows.filter(e => !q || perfSearchMatch(e.name, q) || perfSearchMatch(e.manager, q));
    rows = applyPerfSort(rows);
    body.innerHTML = `<table><thead><tr>${fields.map(([f, l, n]) => perfHeaderCellHtml(f, l, n)).join('')}</tr></thead><tbody>${
      rows.map(e => `
        <tr class="${isDeployedJda(e.id) ? 'perf-deployed' : ''}">
          <td>${e.name}${deployedTag(e.id)}</td>
          <td><a href="#" class="perf-mgr-link" data-mgr="${String(e.manager).replace(/"/g, '&quot;')}" style="color:var(--accent);text-decoration:none;" title="Click to filter the pincode table above to this manager's team">${e.manager}</a></td>
          <td class="num-col">${e.pincodes_covered}</td>
          <td class="num-col">${e.presentations}</td>
          <td class="num-col">${e.jda_sales}</td>
          <td class="num-col">${fmtNum(e.conversion_rate_pct)}</td>
        </tr>`).join('')
    }</tbody></table>`;
  }
  document.querySelectorAll('#perfViewBody .col-filter-icon').forEach(icon => {
    icon.addEventListener('click', (e) => {
      e.stopPropagation();
      const field = icon.dataset.filterK;
      if (perfOpenFilterField === field) { perfCloseColFilterPopup(); return; }
      const label = (PERF_FIELDS[perfView].find(f => f[0] === field) || [, field])[1];
      perfOpenColFilterPopup(field, label, icon);
    });
  });
}
document.getElementById('perfViewBody').addEventListener('click', (e) => {
  if (e.target.closest('.col-filter-icon')) return;
  const th = e.target.closest('th[data-field]');
  if (th) {
    const s = perfSort[perfView];
    if (s.field === th.dataset.field) s.dir *= -1; else { s.field = th.dataset.field; s.dir = -1; }
    renderPerfView();
    return;
  }
  const mgrLink = e.target.closest('.perf-mgr-link');
  if (mgrLink) {
    e.preventDefault();
    e.stopPropagation();
    filterTableToManager(mgrLink.dataset.mgr);
    return;
  }
  const row = e.target.closest('.perf-mgr-row');
  if (!row) return;
  const mgr = row.dataset.mgr;
  if (expandedManagers.has(mgr)) expandedManagers.delete(mgr); else expandedManagers.add(mgr);
  renderPerfView();
});
document.getElementById('perfSearchBox').addEventListener('input', () => renderPerfView());
document.getElementById('expandAllManagersBtn').addEventListener('click', (e) => {
  if (e.currentTarget.textContent === 'Collapse all') expandedManagers.clear();
  else currentPerfData.managerRollup.forEach(m => expandedManagers.add(m.manager));
  renderPerfView();
});
document.getElementById('showAllManagersBtn').addEventListener('click', () => {
  document.getElementById('perfSearchBox').value = '';
  perfColumnFilters.manager = {};
  perfColumnFilters.jda = {};
  clearPincodeFilter();
});
document.querySelectorAll('#perfViewSeg button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#perfViewSeg button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    perfView = btn.dataset.v;
    renderPerfView();
  });
});
populatePeriodSelects();
document.getElementById('periodHeaderText').textContent = `Period: ${fmtDateNice(DAILY.window_start)} – ${fmtDateNice(DAILY.window_end)}`;
renderColorPanel();
renderTableHead();
renderColumnPanel();
renderDQ();
readUrlState();
applyScenario(currentScenario);
</script>

</body>
</html>
