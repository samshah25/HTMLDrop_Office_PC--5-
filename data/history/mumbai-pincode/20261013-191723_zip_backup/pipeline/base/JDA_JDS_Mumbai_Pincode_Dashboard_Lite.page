  renderTableHead();
  setPeriod(DAILY.window_start, DAILY.window_end);
}
document.getElementById('scenarioNote').addEventListener('click', (e) => {
  const x = e.target.closest('[data-chip]');
  if (x) { const c = filterChips[parseInt(x.dataset.chip, 10)]; if (c) c.clear(); return; }
  if (e.target.closest('#clearAllFiltersBtn')) { clearAllFilters(); return; }
  const copy = e.target.closest('#copyViewLinkBtn');
  if (copy) {
    writeUrlState();
    const done = () => { copy.textContent = 'Link copied'; setTimeout(() => { copy.textContent = 'Copy link to this view'; }, 1800); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(location.href).then(done, () => window.prompt('Copy this link:', location.href));
    else window.prompt('Copy this link:', location.href);
  }
});
// ---- view state in the URL (#...), so a reload keeps the view and a link opens it ----
function writeUrlState() {
  try {
    const p = new URLSearchParams();
    if (currentScenario !== 'all') p.set('scn', currentScenario);
    if (currentCityScope !== 'both') p.set('city', currentCityScope);
    if (periodFromDate !== DAILY.window_start) p.set('from', periodFromDate);
    if (periodToDate !== DAILY.window_end) p.set('to', periodToDate);
    p.set('show', renderedLayerKeys().filter(k => layerVisible[k]).join('.'));
    if (bandsShown !== 1) p.set('bands', String(bandsShown));
    if (cutoffs[1] !== 20) p.set('c1', cutoffs[1]);
    if (bandsShown >= 2 && cutoffs[2] !== 20) p.set('c2', cutoffs[2]);
    const q = document.getElementById('searchBox').value.trim(); if (q) p.set('q', q);
    const cf = {};
    Object.keys(columnFilters).forEach(field => {
      const f = columnFilters[field];
      if (!isColumnFilterActive(field)) return;
      if (f.type === 'numeric') cf[field] = ['n', f.op, f.value];
      else if (f.values.size <= 60) cf[field] = ['s', Array.from(f.values)];
    });
    if (Object.keys(cf).length) p.set('cf', JSON.stringify(cf));
    history.replaceState(null, '', location.pathname + location.search + '#' + p.toString());
  } catch (e) { /* URL state is a convenience; never break the page over it */ }
}
function readUrlState() {
  try {
    const p = new URLSearchParams((location.hash || '').replace(/^#/, ''));
    if (!p.has('show')) return;
    const scn = p.get('scn'); if (['all', 'fresh', 'renewal'].includes(scn)) currentScenario = scn;
    document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === currentScenario));
    const city = p.get('city'); if (['both', 'main', 'remote'].includes(city)) currentCityScope = city;
    const sel = document.getElementById('cityScopeSelect'); if (sel) sel.value = currentCityScope;
    const iso = /^\d{4}-\d{2}-\d{2}$/;
    const from = p.get('from'), to = p.get('to');
    if (from && iso.test(from)) periodFromDate = from < DAILY.window_start ? DAILY.window_start : from;
    if (to && iso.test(to)) periodToDate = to > DAILY.window_end ? DAILY.window_end : to;
    if (periodFromDate > periodToDate) { periodFromDate = DAILY.window_start; periodToDate = DAILY.window_end; }
    if (p.get('bands') === '1') bandsShown = 1; else if (p.get('bands') === '2') bandsShown = 2;
    const c1 = parseFloat(p.get('c1')), c2 = parseFloat(p.get('c2'));
    if (!isNaN(c1)) { cutoffs[1] = c1; document.getElementById('cutoff1').value = c1; }
    if (!isNaN(c2)) { cutoffs[2] = c2; document.getElementById('cutoff2').value = c2; }
    updateBandUI();
    const shown = new Set((p.get('show') || '').split('.').filter(Boolean));
    LAYER_KEYS.forEach(k => { layerVisible[k] = shown.has(k) || (bandsShown < 2 && k === 'band3'); });
    const q = p.get('q'); if (q) document.getElementById('searchBox').value = q;
    const cf = p.get('cf');
    if (cf) {
      Object.entries(JSON.parse(cf)).forEach(([field, v]) => {
        if (v[0] === 'n') columnFilters[field] = { type: 'numeric', op: v[1], value: v[2] };
        else if (v[0] === 's') columnFilters[field] = { type: 'set', values: new Set(v[1].map(String)) };
      });
      renderTableHead();
    }
    populatePeriodSelects();
  } catch (e) { /* ignore a malformed link and open the default view */ }
}
function refreshAll() {
  const baseRows = getBaseRows().filter(r => passesColumnFilters(r));
  currentBaseRows = baseRows;
  let rows = baseRows.filter(r => layerVisible[layerOf(r)]);
  currentRows = rows;
  renderFilterBar();
  renderCards(rows);
  renderMap(rows);
  if (MAP_ENABLED && document.getElementById('filterListBody')) renderFilterList(rows);
  renderTable(rows);
  renderMonthBars();
  renderLegend();
  lastClicked = null;
  refreshPerfData();
  if (typeof renderPerfView === 'function' && document.getElementById('perfViewBody')) renderPerfView();
  writeUrlState();
}

function applyScenario(scn) { currentScenario = scn; refreshAll(); }
function applyCityScope(cs) { currentCityScope = cs; refreshAll(); }

function populatePeriodSelects() {
  const fromSel = document.getElementById('periodFrom');
  const toSel = document.getElementById('periodTo');
  [fromSel, toSel].forEach(sel => { sel.min = DAILY.window_start; sel.max = DAILY.window_end; });
  fromSel.value = periodFromDate; toSel.value = periodToDate;
}
function setPeriod(fromDate, toDate) {
  if (fromDate > toDate) { const t = fromDate; fromDate = toDate; toDate = t; }
  if (fromDate < DAILY.window_start) fromDate = DAILY.window_start;
  if (toDate > DAILY.window_end) toDate = DAILY.window_end;
  periodFromDate = fromDate; periodToDate = toDate;
  document.getElementById('periodFrom').value = periodFromDate;
  document.getElementById('periodTo').value = periodToDate;
  refreshAll();
}

