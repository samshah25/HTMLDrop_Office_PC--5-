        const existing = sortLevels.find(s => s.field === k);
        if (existing) existing.dir *= -1;
        else sortLevels.push({ field: k, dir: -1 });
      } else {
        if (sortLevels.length === 1 && sortLevels[0].field === k) sortLevels[0].dir *= -1;
