let sortLevels = [{ field: 'jds_sales', dir: -1 }]; // priority order: index 0 = primary sort

function sortValue(row, field) {
  let v = field === 'place' ? (row.geo ? row.geo.sample_place : '') : row[field];
  if (v === null || v === undefined) return -Infinity;
  if (typeof v === 'boolean') return v ? 1 : 0;
  return v;
}
function multiCompare(a, b) {
  for (const { field, dir } of sortLevels) {
    const av = sortValue(a, field), bv = sortValue(b, field);
    if (av < bv) return -1 * dir;
    if (av > bv) return 1 * dir;
  }
  return 0;
}
function renderSortIndicators() {
  document.querySelectorAll('#dataTable thead th[data-k]').forEach(th => {
    const k = th.dataset.k;
    const i = sortLevels.findIndex(s => s.field === k);
    let ind = th.querySelector('.sort-ind');
    if (!ind) {
      ind = document.createElement('span');
      ind.className = 'sort-ind';
      th.appendChild(ind);
    }
    if (i === -1) {
      ind.textContent = '';
      th.classList.remove('sorted');
    } else {
      const arrow = sortLevels[i].dir === -1 ? '↓' : '↑';
      const sup = sortLevels.length > 1 ? String(i + 1) : '';
      ind.textContent = arrow + sup;
      th.classList.add('sorted');
    }
  });
}
