      r.pincode, 'deals', true) : '';
    const jdaTotal = sg.top.reduce((a, t) => a + t.jda_count, 0) + (sg.other_jda_count || 0);
    const jdsTotal = sg.top.reduce((a, t) => a + t.jds_count, 0) + (sg.other_jds_count || 0);
    const tot = totalRow(totTd(sg.total) + totTd('100%') + totTd(jdaTotal) + totTd(jdsTotal) + totTd(penTxt(overallPen)));
    const head = th('Sales group', 'Top 5 sales groups by deals closed in this pincode; the rest are grouped as All other', 'left')
