      <div style="width:560px; flex-shrink:0; background:var(--panel); border:1px solid var(--border); border-radius:4px; padding:10px 12px;">${monBlock || '<div class="expand-title" style="margin-bottom:6px;">Top sales groups by monetizable listings</div><div style="font-size:10.5px; color:var(--text-dim);"><i>None on file.</i></div>'}</div>
      ${deployedRosterBlock(r)}
