function renderColumnPanel() {
  document.getElementById('columnPanel').innerHTML = `<div class="note" style="margin-bottom:6px;">Drag <span class="col-drag-handle" style="cursor:default;">⠿</span> to reorder columns.</div>` +
    columnOrder.map((k, i) => `
