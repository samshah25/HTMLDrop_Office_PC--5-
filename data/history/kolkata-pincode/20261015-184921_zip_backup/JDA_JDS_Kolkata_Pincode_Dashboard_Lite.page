      ${tableWrap([56, 96, 46, 54], monHead, monBars + monOtherRow + monTot)}`;
  }
  return `<tr class="expand-row"><td colspan="${colspan}" style="padding:6px 10px;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-start;">
