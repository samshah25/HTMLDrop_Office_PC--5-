function fmtDateNice(iso) {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function periodLabel() {
  if (periodFromDate === DAILY.window_start && periodToDate === DAILY.window_end) return `Full window (${fmtDateNice(DAILY.window_start)}–${fmtDateNice(DAILY.window_end)})`;
  if (periodFromDate === periodToDate) return fmtDateNice(periodFromDate) + ' only';
  return `${fmtDateNice(periodFromDate)}–${fmtDateNice(periodToDate)}`;
}

const MAIN_DISTRICTS_TEXT = 'Hooghly | Howrah | Kolkata | North 24 Parganas | South 24 Parganas';
let currentBaseRows = [];   // rows passing every filter except the category cards (for card counts)
let filterChips = [];
function setScenarioUI(scn) {
  document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === scn));
  applyScenario(scn);
}
function setCityScopeUI(cs) {
  const sel = document.getElementById('cityScopeSelect'); if (sel) sel.value = cs;
  applyCityScope(cs);
}
function columnFilterChipLabel(field, f) {
  const name = COLUMN_LABELS[field] || field;
  if (f.type === 'numeric') return `${name} ${f.op} ${f.value}`;
  const vals = Array.from(f.values);
  return vals.length <= 3 ? `${name}: ${vals.join(', ')}` : `${name}: ${vals.length} of ${getDistinctValues(field).length} selected`;
}
function buildFilterChips() {
  const chips = [];
  if (currentScenario !== 'all') chips.push({ label: currentScenario === 'fresh' ? 'Fresh only' : 'Renewal only', clear: () => setScenarioUI('all') });
  if (currentCityScope === 'main') chips.push({ label: `Main only: ${MAIN_DISTRICTS_TEXT}`, clear: () => setCityScopeUI('both') });
  if (currentCityScope === 'remote') chips.push({ label: 'Remote only: outside the 5 main districts', clear: () => setCityScopeUI('both') });
  if (!(periodFromDate === DAILY.window_start && periodToDate === DAILY.window_end))
    chips.push({ label: `Period: ${periodLabel()}`, clear: () => setPeriod(DAILY.window_start, DAILY.window_end) });
  Object.keys(columnFilters).forEach(field => {
    if (!isColumnFilterActive(field)) return;
    const fromManager = field === 'pincode' && savedLayerVisibleBeforeMgrFilter;
    chips.push({ label: fromManager ? `Pincodes of one manager's team (${columnFilters[field].values.size})` : columnFilterChipLabel(field, columnFilters[field]),
      clear: fromManager ? () => clearManagerFilter() : () => { delete columnFilters[field]; renderTableHead(); refreshAll(); } });
  });
  const q = document.getElementById('searchBox').value.trim();
  if (q) chips.push({ label: `Table search: “${q}”`, clear: () => { document.getElementById('searchBox').value = ''; renderTable(currentRows); renderFilterBar(); writeUrlState(); } });
  return chips;
}
function filterSummaryText() {
  const scn = currentScenario === 'all' ? 'Fresh + Renewal' : currentScenario === 'fresh' ? 'Fresh only' : 'Renewal only';
  const city = currentCityScope === 'both' ? 'Main + Remote' : currentCityScope === 'main' ? `Main only (${MAIN_DISTRICTS_TEXT})` : 'Remote only';
  const extra = buildFilterChips().map(c => c.label).filter(l => !l.startsWith('Period:') && !l.startsWith('Main only') && !l.startsWith('Remote only') && l !== scn);
  const hidden = renderedLayerKeys().filter(k => !layerVisible[k]).map(cardShortLabel);
  return [scn, city, periodLabel()].concat(extra).concat(hidden.length ? [`Hidden: ${hidden.join(', ')}`] : []).join(' | ');
}
function renderFilterBar() {
  filterChips = buildFilterChips();
  const esc = t => String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  document.getElementById('scenarioNote').innerHTML = `<div class="filter-bar">${
    filterChips.length
      ? `<span class="fb-label">Filters:</span>${filterChips.map((c, i) => `<span class="chip">${esc(c.label)}<button data-chip="${i}" aria-label="Remove filter: ${esc(c.label)}" title="Remove this filter">×</button></span>`).join('')}<button class="fb-link" id="clearAllFiltersBtn">Clear all</button>`
      : `<span class="fb-label">Showing Fresh + Renewal, Main + Remote, ${esc(periodLabel())}.</span>`
  }<button class="fb-link" id="copyViewLinkBtn" title="Copy a link that opens the dashboard with these filters">Copy link to this view</button></div>`;
}
function clearAllFilters() {
  columnFilters = {};
  if (savedLayerVisibleBeforeMgrFilter) { savedLayerVisibleBeforeMgrFilter = null; document.getElementById('mgrFilterBadge').style.display = 'none'; }
  document.getElementById('searchBox').value = '';
  currentScenario = 'all';
  document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === 'all'));
  currentCityScope = 'both';
  const sel = document.getElementById('cityScopeSelect'); if (sel) sel.value = 'both';
  renderTableHead();
  setPeriod(DAILY.window_start, DAILY.window_end);
}
document.getElementById('scenarioNote').addEventListener('click', (e) => {
  const x = e.target.closest('[data-chip]');
  if (x) { const c = filterChips[parseInt(x.dataset.chip, 10)]; if (c) c.clear(); return; }
  if (e.target.closest('#clearAllFiltersBtn')) { clearAllFilters(); return; }
  const copy = e.target.closest('#copyViewLinkBtn');
  if (copy) {
    writeUrlState();
    const done = () => { copy.textContent = 'Link copied'; setTimeout(() => { copy.textContent = 'Copy link to this view'; }, 1800); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(location.href).then(done, () => window.prompt('Copy this link:', location.href));
    else window.prompt('Copy this link:', location.href);
  }
});
// ---- view state in the URL (#...), so a reload keeps the view and a link opens it ----
function writeUrlState() {
  try {
    const p = new URLSearchParams();
    if (currentScenario !== 'all') p.set('scn', currentScenario);
    if (currentCityScope !== 'both') p.set('city', currentCityScope);
    if (periodFromDate !== DAILY.window_start) p.set('from', periodFromDate);
    if (periodToDate !== DAILY.window_end) p.set('to', periodToDate);
    p.set('show', renderedLayerKeys().filter(k => layerVisible[k]).join('.'));
    if (bandsShown >= 2) p.set('bands', '2');
    if (cutoffs[1] !== 20) p.set('c1', cutoffs[1]);
    if (bandsShown >= 2 && cutoffs[2] !== 10) p.set('c2', cutoffs[2]);
    const q = document.getElementById('searchBox').value.trim(); if (q) p.set('q', q);
    const cf = {};
    Object.keys(columnFilters).forEach(field => {
      const f = columnFilters[field];
      if (!isColumnFilterActive(field)) return;
      if (f.type === 'numeric') cf[field] = ['n', f.op, f.value];
      else if (f.values.size <= 60) cf[field] = ['s', Array.from(f.values)];
    });
    if (Object.keys(cf).length) p.set('cf', JSON.stringify(cf));
    history.replaceState(null, '', location.pathname + location.search + '#' + p.toString());
  } catch (e) { /* URL state is a convenience; never break the page over it */ }
}
function readUrlState() {
  try {
    const p = new URLSearchParams((location.hash || '').replace(/^#/, ''));
    if (!p.has('show')) return;
    const scn = p.get('scn'); if (['all', 'fresh', 'renewal'].includes(scn)) currentScenario = scn;
    document.querySelectorAll('#freshSeg button').forEach(b => b.classList.toggle('active', b.dataset.v === currentScenario));
    const city = p.get('city'); if (['both', 'main', 'remote'].includes(city)) currentCityScope = city;
    const sel = document.getElementById('cityScopeSelect'); if (sel) sel.value = currentCityScope;
    const iso = /^\d{4}-\d{2}-\d{2}$/;
    const from = p.get('from'), to = p.get('to');
    if (from && iso.test(from)) periodFromDate = from < DAILY.window_start ? DAILY.window_start : from;
    if (to && iso.test(to)) periodToDate = to > DAILY.window_end ? DAILY.window_end : to;
    if (periodFromDate > periodToDate) { periodFromDate = DAILY.window_start; periodToDate = DAILY.window_end; }
    if (p.get('bands') === '2') bandsShown = 2;
    const c1 = parseFloat(p.get('c1')), c2 = parseFloat(p.get('c2'));
    if (!isNaN(c1)) { cutoffs[1] = c1; document.getElementById('cutoff1').value = c1; }
    if (!isNaN(c2)) { cutoffs[2] = c2; document.getElementById('cutoff2').value = c2; }
    updateBandUI();
    const shown = new Set((p.get('show') || '').split('.').filter(Boolean));
    LAYER_KEYS.forEach(k => { layerVisible[k] = shown.has(k) || (bandsShown < 2 && k === 'band3'); });
    const q = p.get('q'); if (q) document.getElementById('searchBox').value = q;
    const cf = p.get('cf');
    if (cf) {
      Object.entries(JSON.parse(cf)).forEach(([field, v]) => {
        if (v[0] === 'n') columnFilters[field] = { type: 'numeric', op: v[1], value: v[2] };
        else if (v[0] === 's') columnFilters[field] = { type: 'set', values: new Set(v[1].map(String)) };
      });
      renderTableHead();
    }
    populatePeriodSelects();
  } catch (e) { /* ignore a malformed link and open the default view */ }
}
function refreshAll() {
  const baseRows = getBaseRows().filter(r => passesColumnFilters(r));
  currentBaseRows = baseRows;
  let rows = baseRows.filter(r => layerVisible[layerOf(r)]);
  currentRows = rows;
