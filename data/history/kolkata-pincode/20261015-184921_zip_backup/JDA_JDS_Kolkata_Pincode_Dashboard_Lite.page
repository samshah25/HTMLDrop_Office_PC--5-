      + th('% of deals', 'Share of this pincode\'s deals closed in the selected period')
      + th('JDA', 'Deals closed by JDA (field sales reps)')
      + th('JDS', 'Deals closed by JDS (in-house team)')
      + th('Paid %', 'Paid penetration: % of this sales group\'s monetizable listings in this pincode that are currently paid (from the Monetizable listings data)');
    dealsBlock = `
      <div class="expand-title" style="margin-bottom:6px;">Top sales groups by deals closed — ${periodLabel()}${dealsScenarioNote()}</div>
      ${tableWrap([48, 96, 38, 38, 54], head, bars + otherRow + tot)}`;
  } else {
    dealsBlock = `<div class="expand-title" style="margin-bottom:6px;">Top sales groups by deals closed</div>
      <div style="font-size:10.5px; color:var(--text-dim);"><i>No sales-group-tagged deals in the ${periodLabel()} window.</i></div>`;
  }
  let monBlock = '';
  if (mon && mon.total) {
    const monBars = mon.top.map((t, i) => dataRow(t.sales_group,
      td(t.count, 'font-weight:600; color:var(--text);') + td(shareCell(t.pct, Math.max(0.4, 1 - i * 0.15))) + td(t.paid) + td(penTxt(t.penetration_pct)),
      r.pincode, 'monetizable', false)).join('');
    const otherPaid = mon.total_paid - mon.top.reduce((a, t) => a + t.paid, 0);
    const monOtherRow = mon.other_count ? dataRow('All other',
      td(mon.other_count, 'font-weight:600; color:var(--text);') + td(shareCell(mon.other_pct, 0.25)) + td(otherPaid) + td(penTxt(mon.other_penetration_pct)),
      r.pincode, 'monetizable', true) : '';
    const monTot = totalRow(totTd(mon.total) + totTd('100%') + totTd(mon.total_paid) + totTd(penTxt(overallPen)));
    const monHead = th('Sales group', 'Top 5 sales groups by number of monetizable listings in this pincode; the rest are grouped as All other', 'left')
      + th('Listings', 'Monetizable listings in this pincode')
      + th('% of listings', 'Share of this pincode\'s monetizable listings')
