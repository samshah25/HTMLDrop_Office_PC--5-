        td(t.count, 'font-weight:600; color:var(--text);') + td(shareCell(t.pct, opacity)) + td(t.jda_count) + td(t.jds_count) + td(penTxt(pen)),
        r.pincode, 'deals', false);
    }).join('');
    const otherPen = penetrationForSalesGroup(r.pincode, 'All other', mon);
    const otherRow = sg.other_count ? dataRow('All other',
